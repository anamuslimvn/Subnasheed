[
  {
    "id": 1,
    "start": "00:00:03,351",
    "end": "00:00:06,463",
    "text": "Ya Rabb"
  },
  {
    "id": 2,
    "start": "00:00:06,463",
    "end": "00:00:10,451",
    "text": "Subhanallah"
  },
  {
    "id": 3,
    "start": "00:00:10,451",
    "end": "00:00:27,495",
    "text": "Ya Rabb"
  },
  {
    "id": 4,
    "start": "00:00:27,846",
    "end": "00:00:31,835",
    "text": "Có người mẹ thức trong đêm vắng,"
  },
  {
    "id": 5,
    "start": "00:00:31,835",
    "end": "00:00:35,585",
    "text": "Ánh đèn khuya in bóng hao gầy."
  },
  {
    "id": 6,
    "start": "00:00:35,585",
    "end": "00:00:38,936",
    "text": "Từng hơi thở lo cho con trẻ,"
  },
  {
    "id": 7,
    "start": "00:00:38,936",
    "end": "00:00:42,447",
    "text": "Quên cả mình giữa tháng năm dài."
  },
  {
    "id": 8,
    "start": "00:00:42,447",
    "end": "00:00:46,036",
    "text": "Tay chai sạn qua bao ngày tháng,"
  },
  {
    "id": 9,
    "start": "00:00:46,036",
    "end": "00:00:49,866",
    "text": "Nhưng vẫn mềm khi chạm vào con."
  },
  {
    "id": 10,
    "start": "00:00:49,866",
    "end": "00:00:53,137",
    "text": "Dẫu đời có bao nhiêu mỏi mệt,"
  },
  {
    "id": 11,
    "start": "00:00:53,137",
    "end": "00:00:57,256",
    "text": "Vẫn giữ trọn một tình yêu không lời."
  },
  {
    "id": 12,
    "start": "00:01:03,909",
    "end": "00:01:07,659",
    "text": "Con lớn lên giữa vòng tay ấy,"
  },
  {
    "id": 13,
    "start": "00:01:07,659",
    "end": "00:01:11,250",
    "text": "Mà chẳng hay bao nỗi âm thầm."
  },
  {
    "id": 14,
    "start": "00:01:11,250",
    "end": "00:01:14,521",
    "text": "Những cơn sốt, những đêm không ngủ,"
  },
  {
    "id": 15,
    "start": "00:01:14,521",
    "end": "00:01:18,111",
    "text": "Đều đổi bằng nụ cười bình an."
  },
  {
    "id": 16,
    "start": "00:01:18,111",
    "end": "00:01:21,621",
    "text": "Đến khi đời cho con vấp ngã,"
  },
  {
    "id": 17,
    "start": "00:01:21,621",
    "end": "00:01:24,653",
    "text": "Mới hiểu ra bóng mẹ sau lưng."
  },
  {
    "id": 18,
    "start": "00:01:24,653",
    "end": "00:01:28,802",
    "text": "Như ngọn đèn không bao giờ tắt,"
  },
  {
    "id": 19,
    "start": "00:01:28,802",
    "end": "00:01:32,123",
    "text": "Dẫn con qua những lúc tối tăm."
  },
  {
    "id": 20,
    "start": "00:01:32,472",
    "end": "00:01:34,548",
    "text": "Ya Rabb"
  },
  {
    "id": 21,
    "start": "00:01:34,548",
    "end": "00:01:39,573",
    "text": "Xin thương xót người mẹ hiền."
  },
  {
    "id": 22,
    "start": "00:01:39,573",
    "end": "00:01:43,084",
    "text": "Ban cho họ bình an tuổi cuối,"
  },
  {
    "id": 23,
    "start": "00:01:43,084",
    "end": "00:01:46,754",
    "text": "Giữa cuộc đời nhiều gió sương."
  },
  {
    "id": 24,
    "start": "00:01:46,754",
    "end": "00:01:48,111",
    "text": "Ya Rabb"
  },
  {
    "id": 25,
    "start": "00:01:48,111",
    "end": "00:01:51,302",
    "text": "Xin dạy con biết điều hiếu kính."
  },
  {
    "id": 26,
    "start": "00:01:51,302",
    "end": "00:01:57,447",
    "text": "Đừng để con quên đi ân nghĩa,"
  },
  {
    "id": 27,
    "start": "00:01:57,447",
    "end": "00:02:01,085",
    "text": "Khi còn có mẹ trên đời."
  },
  {
    "id": 28,
    "start": "00:02:01,436",
    "end": "00:02:04,706",
    "text": "Rồi một ngày con đi xa mãi,"
  },
  {
    "id": 29,
    "start": "00:02:04,706",
    "end": "00:02:08,377",
    "text": "Mới giật mình nhìn lại thời gian."
  },
  {
    "id": 30,
    "start": "00:02:08,377",
    "end": "00:02:11,729",
    "text": "Có những lời chưa kịp nói hết,"
  },
  {
    "id": 31,
    "start": "00:02:11,729",
    "end": "00:02:15,159",
    "text": "Chỉ còn lại khoảng trống lặng im."
  },
  {
    "id": 32,
    "start": "00:02:15,159",
    "end": "00:02:18,590",
    "text": "Nếu có thể quay về một lần,"
  },
  {
    "id": 33,
    "start": "00:02:18,590",
    "end": "00:02:22,419",
    "text": "Con xin được nắm lấy bàn tay."
  },
  {
    "id": 34,
    "start": "00:02:22,419",
    "end": "00:02:25,133",
    "text": "Nói một câu chưa từng dám nói:"
  },
  {
    "id": 35,
    "start": "00:02:25,133",
    "end": "00:02:30,128",
    "text": "“Con biết ơn mẹ suốt cuộc đời này.”"
  },
  {
    "id": 36,
    "start": "00:02:37,100",
    "end": "00:02:40,532",
    "text": "Trong ánh sáng của lời mặc khải,"
  },
  {
    "id": 37,
    "start": "00:02:40,532",
    "end": "00:02:44,043",
    "text": "Allah đã nhắc điều hiếu thảo."
  },
  {
    "id": 38,
    "start": "00:02:44,043",
    "end": "00:02:47,313",
    "text": "Sau đức tin nơi Đấng Tối Cao,"
  },
  {
    "id": 39,
    "start": "00:02:47,313",
    "end": "00:02:49,836",
    "text": "Mẹ là người con phải trân quý."
  },
  {
    "id": 40,
    "start": "00:02:50,186",
    "end": "00:02:52,181",
    "text": "Ya Rabb"
  },
  {
    "id": 41,
    "start": "00:02:52,181",
    "end": "00:02:54,574",
    "text": "Nếu một ngày mẹ rời xa con."
  },
  {
    "id": 42,
    "start": "00:02:54,574",
    "end": "00:02:58,164",
    "text": "Xin cho con được kiên nhẫn,"
  },
  {
    "id": 43,
    "start": "00:02:58,164",
    "end": "00:03:01,754",
    "text": "Và cầu nguyện cho mẹ bình an."
  },
  {
    "id": 44,
    "start": "00:03:01,754",
    "end": "00:03:02,872",
    "text": "Ya Rabb"
  },
  {
    "id": 45,
    "start": "00:03:02,872",
    "end": "00:03:06,144",
    "text": "Nếu Ngài thương xót bầy tôi."
  },
  {
    "id": 46,
    "start": "00:03:06,144",
    "end": "00:03:08,936",
    "text": "Xin cho mẹ con được gặp lại,"
  },
  {
    "id": 47,
    "start": "00:03:08,936",
    "end": "00:03:12,575",
    "text": "Trong khu vườn Jannah vĩnh hằng."
  },
  {
    "id": 48,
    "start": "00:03:12,925",
    "end": "00:03:15,558",
    "text": "Allah"
  },
  {
    "id": 49,
    "start": "00:03:15,558",
    "end": "00:03:16,914",
    "text": "Ya Rabb"
  },
  {
    "id": 50,
    "start": "00:03:16,914",
    "end": "00:03:24,223",
    "text": "Subhanallah"
  },
  {
    "id": 51,
    "start": "00:03:33,909",
    "end": "00:03:37,419",
    "text": "Khi mẹ còn ở đây"
  },
  {
    "id": 52,
    "start": "00:03:37,419",
    "end": "00:03:41,090",
    "text": "Xin đừng để yêu thương muộn màng."
  },
  {
    "id": 53,
    "start": "00:03:41,090",
    "end": "00:03:45,558",
    "text": "Bởi có những điều trong đời này"
  },
  {
    "id": 54,
    "start": "00:03:45,558",
    "end": "00:03:48,949",
    "text": "Một khi mất đi sẽ không quay lại."
  }
]