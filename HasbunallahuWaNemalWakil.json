[
  {
    "id": 1,
    "start": "00:00:11,169",
    "end": "00:00:16,675",
    "text": "Hasbunallahu wa ne'mal wakil"
  },
  {
    "id": 2,
    "start": "00:00:16,675",
    "end": "00:00:22,309",
    "text": "Hasbunallahu wa ne'mal wakil"
  },
  {
    "id": 3,
    "start": "00:00:22,660",
    "end": "00:00:25,850",
    "text": "Bề tôi chẳng biết điều gì tốt nhất,"
  },
  {
    "id": 4,
    "start": "00:00:25,850",
    "end": "00:00:28,882",
    "text": "Nhưng Ngài biết mọi điều."
  },
  {
    "id": 5,
    "start": "00:00:28,882",
    "end": "00:00:34,149",
    "text": "Nên lời cầu xin của bề tôi,"
  },
  {
    "id": 6,
    "start": "00:00:34,149",
    "end": "00:00:36,941",
    "text": "Chỉ là đôi tay nghèo khó,"
  },
  {
    "id": 7,
    "start": "00:00:36,941",
    "end": "00:00:39,814",
    "text": "Đưa về phía lòng thương xót."
  },
  {
    "id": 8,
    "start": "00:00:39,814",
    "end": "00:00:42,845",
    "text": "Ngài biết"
  },
  {
    "id": 9,
    "start": "00:00:42,845",
    "end": "00:00:45,399",
    "text": "Điều đang nặng trong trái tim."
  },
  {
    "id": 10,
    "start": "00:00:45,399",
    "end": "00:00:48,112",
    "text": "Ngài biết"
  },
  {
    "id": 11,
    "start": "00:00:48,112",
    "end": "00:00:54,223",
    "text": "Điều chẳng thể gọi thành lời."
  },
  {
    "id": 12,
    "start": "00:01:02,234",
    "end": "00:01:03,909",
    "text": "Ya Rabb"
  },
  {
    "id": 13,
    "start": "00:01:03,909",
    "end": "00:01:07,819",
    "text": "Xin dịu nhẹ với bề tôi."
  },
  {
    "id": 14,
    "start": "00:01:07,819",
    "end": "00:01:13,403",
    "text": "Như mưa rơi trên miền đất khô."
  },
  {
    "id": 15,
    "start": "00:01:13,403",
    "end": "00:01:18,909",
    "text": "Như bình minh chạm vào màn đêm."
  },
  {
    "id": 16,
    "start": "00:01:18,909",
    "end": "00:01:24,573",
    "text": "Trước khi sự nhẫn nại cạn khô,"
  },
  {
    "id": 17,
    "start": "00:01:24,573",
    "end": "00:01:30,239",
    "text": "Xin để lòng thương xót của Ngài,"
  },
  {
    "id": 18,
    "start": "00:01:30,239",
    "end": "00:01:33,400",
    "text": "Đến trước."
  },
  {
    "id": 19,
    "start": "00:01:33,750",
    "end": "00:01:36,063",
    "text": "Có một lời cầu xin,"
  },
  {
    "id": 20,
    "start": "00:01:36,063",
    "end": "00:01:38,617",
    "text": "Bề tôi cất giữ trong tim."
  },
  {
    "id": 21,
    "start": "00:01:38,617",
    "end": "00:01:39,894",
    "text": "Không ai biết"
  },
  {
    "id": 22,
    "start": "00:01:39,894",
    "end": "00:01:44,121",
    "text": "Ngoài Allah."
  },
  {
    "id": 23,
    "start": "00:01:44,121",
    "end": "00:01:46,915",
    "text": "Nếu điều ấy tốt cho bề tôi,"
  },
  {
    "id": 24,
    "start": "00:01:46,915",
    "end": "00:01:49,706",
    "text": "Xin cho nó nở như mùa xuân."
  },
  {
    "id": 25,
    "start": "00:01:49,706",
    "end": "00:01:52,260",
    "text": "Nếu điều ấy đưa bề tôi xa Ngài,"
  },
  {
    "id": 26,
    "start": "00:01:52,260",
    "end": "00:01:56,537",
    "text": "Xin để nó tan như sương sớm."
  },
  {
    "id": 27,
    "start": "00:02:06,701",
    "end": "00:02:07,978",
    "text": "Chỉ cần"
  },
  {
    "id": 28,
    "start": "00:02:07,978",
    "end": "00:02:09,015",
    "text": "Ngài hài lòng."
  },
  {
    "id": 29,
    "start": "00:02:09,015",
    "end": "00:02:10,532",
    "text": "Thì bão giông"
  },
  {
    "id": 30,
    "start": "00:02:10,532",
    "end": "00:02:12,287",
    "text": "Cũng hóa bình yên."
  },
  {
    "id": 31,
    "start": "00:02:12,287",
    "end": "00:02:13,563",
    "text": "Chỉ cần"
  },
  {
    "id": 32,
    "start": "00:02:13,563",
    "end": "00:02:14,600",
    "text": "Ngài ở cùng."
  },
  {
    "id": 33,
    "start": "00:02:14,600",
    "end": "00:02:17,153",
    "text": "Thì nghèo khó"
  },
  {
    "id": 34,
    "start": "00:02:17,153",
    "end": "00:02:18,400",
    "text": "Cũng thành giàu có."
  },
  {
    "id": 35,
    "start": "00:02:18,750",
    "end": "00:02:25,133",
    "text": "Bề tôi không tìm,"
  },
  {
    "id": 36,
    "start": "00:02:25,133",
    "end": "00:02:28,644",
    "text": "Điều trái tim mình muốn."
  },
  {
    "id": 37,
    "start": "00:02:28,644",
    "end": "00:02:31,116",
    "text": "Bề tôi chỉ tìm,"
  },
  {
    "id": 38,
    "start": "00:02:31,116",
    "end": "00:02:34,308",
    "text": "Điều Allah chọn."
  },
  {
    "id": 39,
    "start": "00:02:34,308",
    "end": "00:02:35,984",
    "text": "Vì điều Ngài chọn,"
  },
  {
    "id": 40,
    "start": "00:02:35,984",
    "end": "00:02:39,096",
    "text": "Luôn đẹp hơn,"
  },
  {
    "id": 41,
    "start": "00:02:39,096",
    "end": "00:02:44,889",
    "text": "Điều bề tôi mơ ước."
  },
  {
    "id": 42,
    "start": "00:02:45,239",
    "end": "00:02:49,706",
    "text": "Hasbunallahu wa ne'mal wakil"
  },
  {
    "id": 43,
    "start": "00:02:49,706",
    "end": "00:02:56,489",
    "text": "Hasbunallahu wa ne'mal wakil"
  },
  {
    "id": 44,
    "start": "00:02:56,489",
    "end": "00:03:02,473",
    "text": "Hasbunallahu wa ne'mal wakil"
  },
  {
    "id": 45,
    "start": "00:03:02,473",
    "end": "00:03:13,612",
    "text": "Hasbunallahu wa ne'mal wakil"
  }
]