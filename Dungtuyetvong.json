[
  {
    "id": 1,
    "start": "00:00:41,329",
    "end": "00:00:43,643",
    "text": "Hỡi ánh dương"
  },
  {
    "id": 2,
    "start": "00:00:43,643",
    "end": "00:00:46,277",
    "text": "Xin đừng vội khuất cuối trời."
  },
  {
    "id": 3,
    "start": "00:00:46,277",
    "end": "00:00:49,308",
    "text": "Hãy soi đường cho những bước chân,"
  },
  {
    "id": 4,
    "start": "00:00:49,308",
    "end": "00:00:51,621",
    "text": "Bởi bầy tôi"
  },
  {
    "id": 5,
    "start": "00:00:51,621",
    "end": "00:00:54,255",
    "text": "Đang trở về với ánh sáng."
  },
  {
    "id": 6,
    "start": "00:00:54,255",
    "end": "00:00:57,048",
    "text": "Đừng để đêm tối"
  },
  {
    "id": 7,
    "start": "00:00:57,048",
    "end": "00:00:59,600",
    "text": "Lại phủ kín tâm hồn."
  },
  {
    "id": 8,
    "start": "00:00:59,600",
    "end": "00:01:02,314",
    "text": "Bầy tôi sẽ trở về"
  },
  {
    "id": 9,
    "start": "00:01:02,314",
    "end": "00:01:04,197",
    "text": "Về con đường của sự hướng dẫn."
  },
  {
    "id": 10,
    "start": "00:01:04,548",
    "end": "00:01:09,096",
    "text": "Alhamdulillah"
  },
  {
    "id": 11,
    "start": "00:01:17,951",
    "end": "00:01:19,388",
    "text": "Hãy soi sáng"
  },
  {
    "id": 12,
    "start": "00:01:19,388",
    "end": "00:01:22,260",
    "text": "Như bình minh trên cánh hoa."
  },
  {
    "id": 13,
    "start": "00:01:22,260",
    "end": "00:01:24,733",
    "text": "Như mùa xuân vừa thức giấc,"
  },
  {
    "id": 14,
    "start": "00:01:24,733",
    "end": "00:01:28,644",
    "text": "Mang sắc màu trải khắp nhân gian."
  },
  {
    "id": 15,
    "start": "00:01:28,644",
    "end": "00:01:30,239",
    "text": "Mọi vẻ đẹp"
  },
  {
    "id": 16,
    "start": "00:01:30,239",
    "end": "00:01:32,951",
    "text": "Đều nằm trong sự an bài."
  },
  {
    "id": 17,
    "start": "00:01:32,951",
    "end": "00:01:34,308",
    "text": "Mọi âm thanh"
  },
  {
    "id": 18,
    "start": "00:01:34,308",
    "end": "00:01:36,701",
    "text": "Đều vang lên một lời:"
  },
  {
    "id": 19,
    "start": "00:01:36,701",
    "end": "00:01:39,064",
    "text": "Allah Đấng Toàn Năng."
  },
  {
    "id": 20,
    "start": "00:01:39,415",
    "end": "00:01:42,048",
    "text": "Subhanallah"
  },
  {
    "id": 21,
    "start": "00:01:42,048",
    "end": "00:01:45,399",
    "text": "Subhanallah"
  },
  {
    "id": 22,
    "start": "00:01:45,399",
    "end": "00:01:49,756",
    "text": "La ilaha illallah"
  },
  {
    "id": 23,
    "start": "00:01:50,105",
    "end": "00:01:52,739",
    "text": "Hãy nhìn những đóa hoa đang nở,"
  },
  {
    "id": 24,
    "start": "00:01:52,739",
    "end": "00:01:55,531",
    "text": "Hãy ngửi hương thơm giữa đời này."
  },
  {
    "id": 25,
    "start": "00:01:55,531",
    "end": "00:01:57,766",
    "text": "Nhưng đừng để áo đẹp làm say,"
  },
  {
    "id": 26,
    "start": "00:01:57,766",
    "end": "00:02:01,915",
    "text": "Đừng để tuổi xuân khiến quên ngày trở lại."
  },
  {
    "id": 27,
    "start": "00:02:01,915",
    "end": "00:02:03,670",
    "text": "Bởi phía trước"
  },
  {
    "id": 28,
    "start": "00:02:03,670",
    "end": "00:02:07,739",
    "text": "Là một ngày phải trả lời."
  },
  {
    "id": 29,
    "start": "00:02:07,739",
    "end": "00:02:10,133",
    "text": "Ngày mọi vẻ đẹp của thế gian,"
  },
  {
    "id": 30,
    "start": "00:02:10,133",
    "end": "00:02:14,729",
    "text": "Không thể che một việc đã làm."
  },
  {
    "id": 31,
    "start": "00:02:23,377",
    "end": "00:02:25,133",
    "text": "Hãy nhìn xuống"
  },
  {
    "id": 32,
    "start": "00:02:25,133",
    "end": "00:02:28,723",
    "text": "Nơi đáy biển sâu thẳm."
  },
  {
    "id": 33,
    "start": "00:02:28,723",
    "end": "00:02:32,234",
    "text": "Giữa san hô rực rỡ sắc màu,"
  },
  {
    "id": 34,
    "start": "00:02:32,234",
    "end": "00:02:33,431",
    "text": "Một thế giới mắt người khó thấy,"
  },
  {
    "id": 35,
    "start": "00:02:33,431",
    "end": "00:02:39,734",
    "text": "Vẫn hiện hữu dưới quyền Allah."
  },
  {
    "id": 36,
    "start": "00:02:39,734",
    "end": "00:02:41,010",
    "text": "Rồi hãy nhớ"
  },
  {
    "id": 37,
    "start": "00:02:41,010",
    "end": "00:02:44,840",
    "text": "Có một ngày con người biến mất."
  },
  {
    "id": 38,
    "start": "00:02:44,840",
    "end": "00:02:49,787",
    "text": "Có một người từng ở trong bụng cá,"
  },
  {
    "id": 39,
    "start": "00:02:49,787",
    "end": "00:02:53,456",
    "text": "Nhưng giữa bóng tối"
  },
  {
    "id": 40,
    "start": "00:02:53,456",
    "end": "00:02:55,819",
    "text": "Vẫn tìm được đường về."
  },
  {
    "id": 41,
    "start": "00:02:56,169",
    "end": "00:02:58,802",
    "text": "La ilaha illa Anta"
  },
  {
    "id": 42,
    "start": "00:02:58,802",
    "end": "00:03:01,116",
    "text": "Subhanaka"
  },
  {
    "id": 43,
    "start": "00:03:01,116",
    "end": "00:03:04,149",
    "text": "Inni kuntu minaz-zalimin"
  },
  {
    "id": 44,
    "start": "00:03:04,229",
    "end": "00:03:07,979",
    "text": "Yunus"
  },
  {
    "id": 45,
    "start": "00:03:07,979",
    "end": "00:03:10,293",
    "text": "Giữa ba tầng bóng tối,"
  },
  {
    "id": 46,
    "start": "00:03:10,293",
    "end": "00:03:13,245",
    "text": "Không nhìn thấy một lối ra."
  },
  {
    "id": 47,
    "start": "00:03:13,245",
    "end": "00:03:15,000",
    "text": "Nhưng ông vẫn gọi:"
  },
  {
    "id": 48,
    "start": "00:03:15,000",
    "end": "00:03:17,313",
    "text": "\"Ya Rabb\""
  },
  {
    "id": 49,
    "start": "00:03:17,313",
    "end": "00:03:19,627",
    "text": "Và lòng thương xót"
  },
  {
    "id": 50,
    "start": "00:03:19,627",
    "end": "00:03:21,911",
    "text": "Đã tìm đến nơi sâu nhất."
  },
  {
    "id": 51,
    "start": "00:03:22,260",
    "end": "00:03:23,616",
    "text": "Ya Allah"
  },
  {
    "id": 52,
    "start": "00:03:23,616",
    "end": "00:03:24,973",
    "text": "Ya Rahman"
  },
  {
    "id": 53,
    "start": "00:03:24,973",
    "end": "00:03:26,967",
    "text": "Ya Rahim"
  },
  {
    "id": 54,
    "start": "00:03:30,239",
    "end": "00:03:31,515",
    "text": "Nếu một ngày"
  },
  {
    "id": 55,
    "start": "00:03:31,515",
    "end": "00:03:33,350",
    "text": "Bóng tối phủ quanh bề tôi,"
  },
  {
    "id": 56,
    "start": "00:03:33,350",
    "end": "00:03:40,931",
    "text": "Xin đừng để trái tim tuyệt vọng."
  },
  {
    "id": 57,
    "start": "00:03:40,931",
    "end": "00:03:42,366",
    "text": "Bởi ánh sáng"
  },
  {
    "id": 58,
    "start": "00:03:42,366",
    "end": "00:03:46,276",
    "text": "Không bao giờ rời khỏi người tìm Allah."
  },
  {
    "id": 59,
    "start": "00:03:46,276",
    "end": "00:03:47,633",
    "text": "Dẫu biển sâu"
  },
  {
    "id": 60,
    "start": "00:03:47,633",
    "end": "00:03:48,989",
    "text": "Dẫu đêm dài"
  },
  {
    "id": 61,
    "start": "00:03:48,989",
    "end": "00:03:52,739",
    "text": "Dẫu con đường không còn thấy lối."
  },
  {
    "id": 62,
    "start": "00:03:52,739",
    "end": "00:03:55,039",
    "text": "Chỉ cần quay về"
  },
  {
    "id": 63,
    "start": "00:03:55,039",
    "end": "00:03:56,060",
    "text": "Và gọi Ngài."
  },
  {
    "id": 64,
    "start": "00:03:56,409",
    "end": "00:03:59,043",
    "text": "La ilaha illa Anta"
  },
  {
    "id": 65,
    "start": "00:03:59,043",
    "end": "00:04:01,355",
    "text": "Subhanaka"
  },
  {
    "id": 66,
    "start": "00:04:01,355",
    "end": "00:04:04,787",
    "text": "Inni kuntu minaz-zalimin"
  },
  {
    "id": 67,
    "start": "00:04:04,787",
    "end": "00:04:13,628",
    "text": "Alhamdulillah"
  },
  {
    "id": 68,
    "start": "00:04:17,872",
    "end": "00:04:20,185",
    "text": "Ánh sáng vẫn còn"
  },
  {
    "id": 69,
    "start": "00:04:20,185",
    "end": "00:04:23,298",
    "text": "Khi trái tim biết trở về"
  }
]