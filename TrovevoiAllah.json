[
  {
    "id": 1,
    "start": "00:00:04,149",
    "end": "00:00:08,776",
    "text": "Ya Rabb"
  },
  {
    "id": 2,
    "start": "00:00:08,776",
    "end": "00:00:13,005",
    "text": "Ya Rabb"
  },
  {
    "id": 3,
    "start": "00:00:13,005",
    "end": "00:00:33,639",
    "text": "Astaghfirullah"
  },
  {
    "id": 4,
    "start": "00:00:33,988",
    "end": "00:00:38,378",
    "text": "Có những ngày đi thật xa,"
  },
  {
    "id": 5,
    "start": "00:00:38,378",
    "end": "00:00:42,606",
    "text": "Quên mất mình từ đâu đến."
  },
  {
    "id": 6,
    "start": "00:00:42,606",
    "end": "00:00:46,835",
    "text": "Chạy theo bao điều nơi thế gian,"
  },
  {
    "id": 7,
    "start": "00:00:46,835",
    "end": "00:00:49,947",
    "text": "Để trái tim dần thêm nặng nề."
  },
  {
    "id": 8,
    "start": "00:00:49,947",
    "end": "00:00:56,887",
    "text": "Có những lần vấp ngã âm thầm,"
  },
  {
    "id": 9,
    "start": "00:00:56,887",
    "end": "00:01:01,595",
    "text": "Không ai hay, không ai biết đến."
  },
  {
    "id": 10,
    "start": "00:01:01,595",
    "end": "00:01:06,302",
    "text": "Chỉ còn lại trong đêm tĩnh lặng,"
  },
  {
    "id": 11,
    "start": "00:01:06,302",
    "end": "00:01:09,783",
    "text": "Một lời gọi khẽ từ sâu tâm."
  },
  {
    "id": 12,
    "start": "00:01:13,084",
    "end": "00:01:17,793",
    "text": "Không ai thoát khỏi những sai lầm,"
  },
  {
    "id": 13,
    "start": "00:01:17,793",
    "end": "00:01:20,346",
    "text": "Không ai luôn vững vàng mãi mãi."
  },
  {
    "id": 14,
    "start": "00:01:20,346",
    "end": "00:01:27,287",
    "text": "Nhưng cánh cửa vẫn luôn rộng mở,"
  },
  {
    "id": 15,
    "start": "00:01:27,287",
    "end": "00:01:31,995",
    "text": "Khi trái tim biết quay trở về."
  },
  {
    "id": 16,
    "start": "00:01:31,995",
    "end": "00:01:36,701",
    "text": "Chỉ cần một giọt lệ ăn năn,"
  },
  {
    "id": 17,
    "start": "00:01:36,701",
    "end": "00:01:41,329",
    "text": "Chỉ cần một lời xin tha thứ."
  },
  {
    "id": 18,
    "start": "00:01:41,329",
    "end": "00:01:45,956",
    "text": "Allah vẫn luôn đầy khoan dung,"
  },
  {
    "id": 19,
    "start": "00:01:45,956",
    "end": "00:01:48,560",
    "text": "Hơn mọi điều mà ta tưởng tượng."
  },
  {
    "id": 20,
    "start": "00:01:48,909",
    "end": "00:01:49,149",
    "text": "Ya Rabb"
  },
  {
    "id": 21,
    "start": "00:01:49,149",
    "end": "00:01:55,771",
    "text": "Xin dẫn bầy tôi trở về Ngài."
  },
  {
    "id": 22,
    "start": "00:01:55,771",
    "end": "00:02:00,399",
    "text": "Khi đôi chân đã đi quá xa,"
  },
  {
    "id": 23,
    "start": "00:02:00,399",
    "end": "00:02:06,701",
    "text": "Xin mở lối cho ngày quay lại."
  },
  {
    "id": 24,
    "start": "00:02:06,701",
    "end": "00:02:07,739",
    "text": "Ya Rabb"
  },
  {
    "id": 25,
    "start": "00:02:07,739",
    "end": "00:02:12,127",
    "text": "Xin giữ bầy tôi trong lòng Ngài."
  },
  {
    "id": 26,
    "start": "00:02:12,127",
    "end": "00:02:16,914",
    "text": "Trước khi thế gian này kết thúc,"
  },
  {
    "id": 27,
    "start": "00:02:16,914",
    "end": "00:02:23,586",
    "text": "Cho linh hồn được thấy ánh sáng."
  },
  {
    "id": 28,
    "start": "00:02:23,936",
    "end": "00:02:28,004",
    "text": "Ngày hôm nay vẫn còn cơ hội,"
  },
  {
    "id": 29,
    "start": "00:02:28,004",
    "end": "00:02:32,633",
    "text": "Để sửa lại những điều đã qua."
  },
  {
    "id": 30,
    "start": "00:02:32,633",
    "end": "00:02:36,782",
    "text": "Đừng để đến khi nhắm mắt lại,"
  },
  {
    "id": 31,
    "start": "00:02:36,782",
    "end": "00:02:41,967",
    "text": "Mới mong tìm đường về với Ngài."
  },
  {
    "id": 32,
    "start": "00:02:41,967",
    "end": "00:02:46,116",
    "text": "Bởi mỗi hơi thở còn tồn tại,"
  },
  {
    "id": 33,
    "start": "00:02:46,116",
    "end": "00:02:49,229",
    "text": "Là một ân huệ từ Rabb ban."
  },
  {
    "id": 34,
    "start": "00:02:49,229",
    "end": "00:02:55,611",
    "text": "Đừng để trái tim thêm lạc lối,"
  },
  {
    "id": 35,
    "start": "00:02:55,611",
    "end": "00:02:59,968",
    "text": "Khi ánh sáng vẫn còn chưa tàn."
  },
  {
    "id": 36,
    "start": "00:03:03,510",
    "end": "00:03:05,745",
    "text": "La ilaha illallah"
  },
  {
    "id": 37,
    "start": "00:03:05,745",
    "end": "00:03:08,058",
    "text": "Không có Đấng nào ngoài Allah."
  },
  {
    "id": 38,
    "start": "00:03:08,058",
    "end": "00:03:10,451",
    "text": "Mọi con đường rồi sẽ kết thúc,"
  },
  {
    "id": 39,
    "start": "00:03:10,451",
    "end": "00:03:14,251",
    "text": "Chỉ còn lại Ngài mãi trường tồn."
  },
  {
    "id": 40,
    "start": "00:03:14,600",
    "end": "00:03:15,638",
    "text": "Ya Rabb"
  },
  {
    "id": 41,
    "start": "00:03:15,638",
    "end": "00:03:19,787",
    "text": "Xin cho bầy tôi biết trở về."
  },
  {
    "id": 42,
    "start": "00:03:19,787",
    "end": "00:03:24,495",
    "text": "Trước khi màn đêm phủ tất cả,"
  },
  {
    "id": 43,
    "start": "00:03:24,495",
    "end": "00:03:31,037",
    "text": "Trước khi cơ hội không còn nữa."
  },
  {
    "id": 44,
    "start": "00:03:31,037",
    "end": "00:03:31,835",
    "text": "Ya Rabb"
  },
  {
    "id": 45,
    "start": "00:03:31,835",
    "end": "00:03:36,144",
    "text": "Nếu một ngày rời xa thế gian,"
  },
  {
    "id": 46,
    "start": "00:03:36,144",
    "end": "00:03:40,931",
    "text": "Xin cho bầy tôi được gặp Ngài,"
  },
  {
    "id": 47,
    "start": "00:03:40,931",
    "end": "00:03:46,325",
    "text": "Trong ánh sáng của Ngày Sau."
  },
  {
    "id": 48,
    "start": "00:03:46,675",
    "end": "00:03:48,750",
    "text": "Subhanallah"
  },
  {
    "id": 49,
    "start": "00:03:48,750",
    "end": "00:03:51,063",
    "text": "Alhamdulillah"
  },
  {
    "id": 50,
    "start": "00:03:51,063",
    "end": "00:03:53,746",
    "text": "Allahu akbar"
  },
  {
    "id": 51,
    "start": "00:03:58,723",
    "end": "00:04:03,431",
    "text": "Trở về với Ngài"
  },
  {
    "id": 52,
    "start": "00:04:03,431",
    "end": "00:04:08,058",
    "text": "Là con đường không bao giờ muộn,"
  },
  {
    "id": 53,
    "start": "00:04:08,058",
    "end": "00:04:11,330",
    "text": "Cho đến khi"
  },
  {
    "id": 54,
    "start": "00:04:11,330",
    "end": "00:04:15,399",
    "text": "Hơi thở cuối cùng dừng lại."
  }
]