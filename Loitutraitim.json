[
  {
    "id": 1,
    "start": "00:00:09,414",
    "end": "00:00:19,356",
    "text": "Allah Ya Allah"
  },
  {
    "id": 2,
    "start": "00:00:19,707",
    "end": "00:00:23,617",
    "text": "Tôi tin nơi Allah,"
  },
  {
    "id": 3,
    "start": "00:00:23,617",
    "end": "00:00:28,484",
    "text": "Tin nơi các Thiên Thần của Ngài."
  },
  {
    "id": 4,
    "start": "00:00:28,484",
    "end": "00:00:33,350",
    "text": "Tin nơi các Kinh Sách của Ngài,"
  },
  {
    "id": 5,
    "start": "00:00:33,350",
    "end": "00:00:38,856",
    "text": "Tin nơi các Sứ Giả được cử đến."
  },
  {
    "id": 6,
    "start": "00:00:38,856",
    "end": "00:00:43,722",
    "text": "Tôi tin vào Ngày Sau,"
  },
  {
    "id": 7,
    "start": "00:00:43,722",
    "end": "00:00:48,590",
    "text": "Tin rằng mọi định mệnh,"
  },
  {
    "id": 8,
    "start": "00:00:48,590",
    "end": "00:00:53,536",
    "text": "Điều tốt và điều khó khăn,"
  },
  {
    "id": 9,
    "start": "00:00:53,536",
    "end": "00:00:58,134",
    "text": "Đều thuộc sự an bài của Allah."
  },
  {
    "id": 10,
    "start": "00:00:58,484",
    "end": "00:01:02,713",
    "text": "Tôi tin vào sự phục sinh"
  },
  {
    "id": 11,
    "start": "00:01:02,713",
    "end": "00:01:04,308",
    "text": "và chứng nhận rằng:"
  },
  {
    "id": 12,
    "start": "00:01:04,308",
    "end": "00:01:08,186",
    "text": "La ilaha illallah."
  },
  {
