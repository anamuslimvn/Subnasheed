[
  {
    "id": 1,
    "start": "00:00:25,931",
    "end": "00:00:29,042",
    "text": "Hãy nói với người thức cùng đêm tối,"
  },
  {
    "id": 2,
    "start": "00:00:29,042",
    "end": "00:00:33,590",
    "text": "Để tìm cho mình một ánh sáng cao."
  },
  {
    "id": 3,
    "start": "00:00:33,590",
    "end": "00:00:36,621",
    "text": "Ngày hạnh phúc rồi sẽ đến,"
  },
  {
    "id": 4,
    "start": "00:00:36,621",
    "end": "00:00:39,972",
    "text": "Khi bàn tay được hái những quả lành."
  },
  {
    "id": 5,
    "start": "00:00:39,972",
    "end": "00:00:43,244",
    "text": "Bạn có nhớ những đêm dài lặng lẽ,"
  },
  {
    "id": 6,
    "start": "00:00:43,244",
    "end": "00:00:47,234",
    "text": "Một mình ôm Qur'an giữa tĩnh mịch?"
  },
  {
    "id": 7,
    "start": "00:00:47,234",
    "end": "00:00:50,345",
    "text": "Một câu đọc rồi thêm lần nữa,"
  },
  {
    "id": 8,
    "start": "00:00:50,345",
    "end": "00:00:53,106",
    "text": "Để từng lời ở lại trong tim."
  },
  {
    "id": 9,
    "start": "00:00:53,457",
    "end": "00:00:54,734",
    "text": "Alhamdulillah"
  },
  {
    "id": 10,
    "start": "00:00:54,734",
    "end": "00:00:56,887",
    "text": "Alhamdulillah"
  },
  {
    "id": 11,
    "start": "00:00:56,887",
    "end": "00:00:58,085",
    "text": "Alhamdulillah"
  },
  {
    "id": 12,
    "start": "00:00:58,085",
    "end": "00:01:04,069",
    "text": "Bạn có nhớ những giờ phút khó khăn,"
  },
  {
    "id": 13,
    "start": "00:01:04,069",
    "end": "00:01:07,819",
    "text": "Khi Qur'an xoa dịu những ưu phiền?"
  },
  {
    "id": 14,
    "start": "00:01:07,819",
    "end": "00:01:10,611",
    "text": "Khi bề tôi tìm đến Allah,"
  },
  {
    "id": 15,
    "start": "00:01:10,611",
    "end": "00:01:14,361",
    "text": "Iblis cũng chẳng thể làm lay chuyển."
  },
  {
    "id": 16,
    "start": "00:01:14,361",
    "end": "00:01:15,718",
    "text": "Một câu đọc"
  },
  {
    "id": 17,
    "start": "00:01:15,718",
    "end": "00:01:17,712",
    "text": "Rồi lại đọc thêm lần nữa."
  },
  {
    "id": 18,
    "start": "00:01:17,712",
    "end": "00:01:19,149",
    "text": "Đọc bằng môi"
  },
  {
    "id": 19,
    "start": "00:01:19,149",
    "end": "00:01:21,543",
    "text": "Và suy ngẫm bằng tim."
  },
  {
    "id": 20,
    "start": "00:01:21,543",
    "end": "00:01:24,495",
    "text": "Cho đến khi những điều tưởng rất khó,"
  },
  {
    "id": 21,
    "start": "00:01:24,495",
    "end": "00:01:24,515",
    "text": "Dần trở thành một phần của tâm hồn."
  },
  {
    "id": 22,
    "start": "00:01:24,495",
    "end": "00:01:27,069",
    "text": "Bề tôi gặp phần thưởng Allah đã hứa."
  },
  {
    "id": 23,
    "start": "00:01:27,367",
    "end": "00:01:30,584",
    "text": "La ilaha illallah"
  },
  {
    "id": 24,
    "start": "00:01:30,584",
    "end": "00:01:31,995",
    "text": "Alhamdulillah"
  },
  {
    "id": 25,
    "start": "00:01:31,995",
    "end": "00:01:36,382",
    "text": "Subhanallah"
  },
  {
    "id": 26,
    "start": "00:01:41,728",
    "end": "00:01:45,159",
    "text": "Bạn có nhớ giọng mình trong đêm vắng,"
  },
  {
    "id": 27,
    "start": "00:01:45,159",
    "end": "00:01:48,750",
    "text": "Khi sương khuya còn phủ trên hiên?"
  },
  {
    "id": 28,
    "start": "00:01:48,750",
    "end": "00:01:52,021",
    "text": "Một mình đọc Qur'an trước bình minh,"
  },
  {
    "id": 29,
    "start": "00:01:52,021",
    "end": "00:01:55,451",
    "text": "Trong khoảnh khắc chẳng một ai hay biết."
  },
  {
    "id": 30,
    "start": "00:01:55,451",
    "end": "00:01:56,888",
    "text": "Những câu ayah"
  },
  {
    "id": 31,
    "start": "00:01:56,888",
    "end": "00:01:59,201",
    "text": "Như mưa rơi xuống đất khô."
  },
  {
    "id": 32,
    "start": "00:01:59,201",
    "end": "00:02:02,632",
    "text": "Đánh thức một tâm hồn cằn cỗi,"
  },
  {
    "id": 33,
    "start": "00:02:02,632",
    "end": "00:02:05,266",
    "text": "Để từ đó"
  },
  {
    "id": 34,
    "start": "00:02:05,266",
    "end": "00:02:06,781",
    "text": "Một khu vườn lại xanh."
  },
  {
    "id": 35,
    "start": "00:02:13,403",
    "end": "00:02:17,633",
    "text": "Hỡi người mang Qur'an trong trái tim,"
  },
  {
    "id": 36,
    "start": "00:02:17,633",
    "end": "00:02:19,548",
    "text": "Hãy bước đi"
  },
  {
    "id": 37,
    "start": "00:02:19,548",
    "end": "00:02:20,585",
    "text": "Đừng dừng lại."
  },
  {
    "id": 38,
    "start": "00:02:20,585",
    "end": "00:02:22,899",
    "text": "Mỗi bước chân vì Qur'an,"
  },
  {
    "id": 39,
    "start": "00:02:22,899",
    "end": "00:02:26,250",
    "text": "Là một viên ngọc được cất giữ."
  },
  {
    "id": 40,
    "start": "00:02:26,250",
    "end": "00:02:27,526",
    "text": "Đọc đi"
  },
  {
    "id": 41,
    "start": "00:02:27,526",
    "end": "00:02:28,403",
    "text": "Lặp lại"
  },
  {
    "id": 42,
    "start": "00:02:28,403",
    "end": "00:02:29,760",
    "text": "Rồi ôn lại những ayah."
  },
  {
    "id": 43,
    "start": "00:02:29,760",
    "end": "00:02:30,877",
    "text": "Đừng để một ngày,"
  },
  {
    "id": 44,
    "start": "00:02:30,877",
    "end": "00:02:34,467",
    "text": "Điều từng thuộc về tim"
  },
  {
    "id": 45,
    "start": "00:02:34,467",
    "end": "00:02:38,058",
    "text": "Lại rời khỏi tim."
  },
  {
    "id": 46,
    "start": "00:02:38,058",
    "end": "00:02:39,574",
    "text": "Alhamdulillah"
  },
  {
    "id": 47,
    "start": "00:02:39,574",
    "end": "00:02:40,451",
    "text": "Ya Allah"
  },
  {
    "id": 48,
    "start": "00:02:40,451",
    "end": "00:02:41,489",
    "text": "Ya Allah"
  },
  {
    "id": 49,
    "start": "00:02:41,489",
    "end": "00:02:43,004",
    "text": "Alhamdulillah"
  },
  {
    "id": 50,
    "start": "00:02:43,004",
    "end": "00:02:43,883",
    "text": "Ya Allah"
  },
  {
    "id": 51,
    "start": "00:02:43,883",
    "end": "00:02:45,159",
    "text": "Ya Allah"
  },
  {
    "id": 52,
    "start": "00:02:45,159",
    "end": "00:02:48,590",
    "text": "Bạn có nhớ giây phút mình hồi hộp,"
  },
  {
    "id": 53,
    "start": "00:02:48,590",
    "end": "00:02:52,020",
    "text": "Khi ngồi trước những người kiểm tra?"
  },
  {
    "id": 54,
    "start": "00:02:52,020",
    "end": "00:02:53,616",
    "text": "Rồi một tiếng:"
  },
  {
    "id": 55,
    "start": "00:02:53,616",
    "end": "00:02:55,451",
    "text": "\"Đủ rồi\""
  },
  {
    "id": 56,
    "start": "00:02:55,451",
    "end": "00:02:58,644",
    "text": "Và nụ cười tràn ra như ánh sáng."
  },
  {
    "id": 57,
    "start": "00:02:58,644",
    "end": "00:02:59,840",
    "text": "Một tiếng thở dài"
  },
  {
    "id": 58,
    "start": "00:02:59,840",
    "end": "00:03:02,074",
    "text": "Nhưng sao nhẹ đến thế."
  },
  {
    "id": 59,
    "start": "00:03:02,074",
    "end": "00:03:05,664",
    "text": "Bởi những đêm dài,"
  },
  {
    "id": 60,
    "start": "00:03:05,664",
    "end": "00:03:08,697",
    "text": "Cuối cùng đã có câu trả lời."
  },
  {
    "id": 61,
    "start": "00:03:08,936",
    "end": "00:03:10,931",
    "text": "Alhamdulillah"
  },
  {
    "id": 62,
    "start": "00:03:12,287",
    "end": "00:03:15,558",
    "text": "Subhanallah"
  },
  {
    "id": 63,
    "start": "00:03:15,558",
    "end": "00:03:16,355",
    "text": "Và rồi"
  },
  {
    "id": 64,
    "start": "00:03:16,355",
    "end": "00:03:18,270",
    "text": "Bạn nghĩ xem"
  },
  {
    "id": 65,
    "start": "00:03:18,270",
    "end": "00:03:22,419",
    "text": "Phần thưởng của Allah sẽ thế nào,"
  },
  {
    "id": 66,
    "start": "00:03:22,419",
    "end": "00:03:24,335",
    "text": "Vào ngày không còn nước mắt,"
  },
  {
    "id": 67,
    "start": "00:03:24,335",
    "end": "00:03:26,010",
    "text": "Không còn mỏi mệt,"
  },
  {
    "id": 68,
    "start": "00:03:26,010",
    "end": "00:03:28,484",
    "text": "Chỉ còn niềm vui"
  },
  {
    "id": 69,
    "start": "00:03:28,484",
    "end": "00:03:31,835",
    "text": "Và những chiếc ghế nơi Jannah."
  },
  {
    "id": 70,
    "start": "00:03:40,850",
    "end": "00:03:43,164",
    "text": "Hỡi người mang Qur'an"
  },
  {
    "id": 71,
    "start": "00:03:43,164",
    "end": "00:03:46,835",
    "text": "Phúc thay từng bước chân của bề tôi."
  },
  {
    "id": 72,
    "start": "00:03:46,835",
    "end": "00:03:48,510",
    "text": "Hãy đi"
  },
  {
    "id": 73,
    "start": "00:03:48,510",
    "end": "00:03:49,787",
    "text": "Đừng dừng lại."
  },
  {
    "id": 74,
    "start": "00:03:49,787",
    "end": "00:03:53,697",
    "text": "Hãy để Qur'an lại phía sau,"
  },
  {
    "id": 75,
    "start": "00:03:53,697",
    "end": "00:03:56,169",
    "text": "Một dấu chân của điều thiện."
  },
  {
    "id": 76,
    "start": "00:03:56,169",
    "end": "00:03:56,649",
    "text": "Đọc"
  },
  {
    "id": 77,
    "start": "00:03:56,649",
    "end": "00:03:57,287",
    "text": "Rồi đọc"
  },
  {
    "id": 78,
    "start": "00:03:57,287",
    "end": "00:03:59,840",
    "text": "Rồi nâng mình lên cùng từng ayah."
  },
  {
    "id": 79,
    "start": "00:03:59,840",
    "end": "00:04:03,909",
    "text": "Cho đến ngày được gọi:"
  },
  {
    "id": 80,
    "start": "00:04:03,909",
    "end": "00:04:06,144",
    "text": "\"Hãy đọc hãy ngân nga và hãy th"
  },
  {
    "id": 81,
    "start": "00:04:06,144",
    "end": "00:04:07,500",
    "text": "ăng lên.\""
  },
  {
    "id": 82,
    "start": "00:04:07,500",
    "end": "00:04:08,377",
    "text": "Và cứ thế"
  },
  {
    "id": 83,
    "start": "00:04:08,377",
    "end": "00:04:10,770",
    "text": "Từng câu Qur'an"
  },
  {
    "id": 84,
    "start": "00:04:10,770",
    "end": "00:04:14,361",
    "text": "Đưa bề tôi lên cao hơn."
  },
  {
    "id": 85,
    "start": "00:04:14,361",
    "end": "00:04:15,717",
    "text": "Cho đến khi"
  },
  {
    "id": 86,
    "start": "00:04:15,717",
    "end": "00:04:20,346",
    "text": "Bề tôi gặp phần thưởng Allah đã hứa."
  },
  {
    "id": 87,
    "start": "00:04:20,346",
    "end": "00:04:23,298",
    "text": "La ilaha illallah"
  },
  {
    "id": 88,
    "start": "00:04:23,298",
    "end": "00:04:27,206",
    "text": "Alhamdulillah"
  },
  {
    "id": 89,
    "start": "00:04:27,206",
    "end": "00:04:30,238",
    "text": "La ilaha illallah"
  },
  {
    "id": 90,
    "start": "00:04:30,238",
    "end": "00:04:43,004",
    "text": "Alhamdulillah"
  },
  {
    "id": 91,
    "start": "00:04:44,761",
    "end": "00:04:46,435",
    "text": "Qur'an trong tim"
  },
  {
    "id": 92,
    "start": "00:04:46,435",
    "end": "00:04:48,589",
    "text": "Ánh sáng trên đường"
  }
]