[
  {
    "id": 1,
    "start": "00:00:19,628",
    "end": "00:00:24,972",
    "text": "Nếu trái tim yêu Allah, bề tôi thật hạnh phúc,"
  },
  {
    "id": 2,
    "start": "00:00:24,972",
    "end": "00:00:29,440",
    "text": "Có Ngài đồng hành, còn điều gì phải sợ?"
  },
  {
    "id": 3,
    "start": "00:00:29,440",
    "end": "00:00:31,515",
    "text": "Dẫu cả thế gian quay lưng,"
  },
  {
    "id": 4,
    "start": "00:00:31,515",
    "end": "00:00:34,387",
    "text": "Dẫu mọi cánh cửa khép lại,"
  },
  {
    "id": 5,
    "start": "00:00:34,387",
    "end": "00:00:39,335",
    "text": "Chỉ cần có Allah, bề tôi vẫn còn tất cả."
  },
  {
    "id": 6,
    "start": "00:00:39,335",
    "end": "00:00:45,079",
    "text": "Chỉ cần Allah thôi, cần Allah thôi,"
  },
  {
    "id": 7,
    "start": "00:00:45,079",
    "end": "00:00:49,468",
    "text": "Cho trái tim, cho cuộc sống."
  },
  {
    "id": 8,
    "start": "00:00:49,468",
    "end": "00:00:54,814",
    "text": "Chỉ Allah thôi, cần Allah thôi,"
  },
  {
    "id": 9,
    "start": "00:00:54,814",
    "end": "00:00:59,170",
    "text": "Ngay cả lòng chẳng còn vững vàng."
  },
  {
    "id": 10,
    "start": "00:00:59,521",
    "end": "00:01:01,994",
    "text": "Bề tôi từng mong họ đừng rời bước,"
  },
  {
    "id": 11,
    "start": "00:01:01,994",
    "end": "00:01:04,468",
    "text": "Từng mong cuộc đời thuận theo ý mình."
  },
  {
    "id": 12,
    "start": "00:01:04,468",
    "end": "00:01:07,180",
    "text": "Từng tưởng những điều mình có sẽ ở lại"
  },
  {
    "id": 13,
    "start": "00:01:07,180",
    "end": "00:01:09,573",
    "text": "Sẽ lấp đầy khoảng trống trong tim."
  },
  {
    "id": 14,
    "start": "00:01:09,573",
    "end": "00:01:11,808",
    "text": "Nhưng vạn vật rồi đổi thay,"
  },
  {
    "id": 15,
    "start": "00:01:11,808",
    "end": "00:01:14,441",
    "text": "Những gì hôm nay, mai có thể mất."
  },
  {
    "id": 16,
    "start": "00:01:14,441",
    "end": "00:01:16,834",
    "text": "Rồi một ngày, trái tim cũng hiểu ra:"
  },
  {
    "id": 17,
    "start": "00:01:16,834",
    "end": "00:01:18,510",
    "text": "Khi cả thế gian rời bỏ,"
  },
  {
    "id": 18,
    "start": "00:01:18,510",
    "end": "00:01:20,983",
    "text": "Allah vẫn tồn tại mãi."
  },
  {
    "id": 19,
    "start": "00:01:20,983",
    "end": "00:01:26,170",
    "text": "Chỉ cần Allah thôi, bề tôi thật hanh phúc,"
  },
  {
    "id": 20,
    "start": "00:01:26,170",
    "end": "00:01:30,638",
    "text": "Có Ngài bên cạnh, còn điều gì đáng sợ?"
  },
  {
    "id": 21,
    "start": "00:01:30,638",
    "end": "00:01:32,793",
    "text": "Dẫu cả thế gian quay lưng,"
  },
  {
    "id": 22,
    "start": "00:01:32,793",
    "end": "00:01:35,665",
    "text": "Dẫu mọi cánh cửa khép lại,"
  },
  {
    "id": 23,
    "start": "00:01:35,665",
    "end": "00:01:41,697",
    "text": "Chỉ cần có Allah, bề tôi vẫn còn tất cả."
  },
  {
    "id": 24,
    "start": "00:01:42,048",
    "end": "00:01:44,121",
    "text": "Có lẽ cánh cửa này không mở"
  },
  {
    "id": 25,
    "start": "00:01:44,121",
    "end": "00:01:46,995",
    "text": "Là vì Ngài muốn chở che trái tim."
  },
  {
    "id": 26,
    "start": "00:01:46,995",
    "end": "00:01:49,069",
    "text": "Có lẽ điều bề tôi từng khóc để có"
  },
  {
    "id": 27,
    "start": "00:01:49,069",
    "end": "00:01:51,781",
    "text": "Sẽ khiến lòng chẳng tìm được bình yên."
  },
  {
    "id": 28,
    "start": "00:01:51,781",
    "end": "00:01:53,936",
    "text": "Dẫu chưa thấy điều đang chờ phía trước."
  },
  {
    "id": 29,
    "start": "00:01:53,936",
    "end": "00:01:56,409",
    "text": "Nhưng Ngài biết điều tốt đẹp cho bề tôi,"
  },
  {
    "id": 30,
    "start": "00:01:56,409",
    "end": "00:01:58,245",
    "text": "Dẫu chưa được thấu hiểu,"
  },
  {
    "id": 31,
    "start": "00:02:01,915",
    "end": "00:02:01,915",
    "text": "Bề tôi vẫn tin và phó thác nơi Ngài."
  },
  {
    "id": 32,
    "start": "00:02:01,915",
    "end": "00:02:04,628",
    "text": "Cứ lấy đi tiền tài, lấy đi danh vọng,"
  },
  {
    "id": 33,
    "start": "00:02:04,628",
    "end": "00:02:07,021",
    "text": "Lời khen ngợi, lấy cả tên bề tôi."
  },
  {
    "id": 34,
    "start": "00:02:07,021",
    "end": "00:02:09,335",
    "text": "Nếu Ngài muốn, lấy cả thế gian đi,"
  },
  {
    "id": 35,
    "start": "00:02:09,335",
    "end": "00:02:14,330",
    "text": "Chỉ cần còn Ngài, bề tôi mất gì đâu?"
  },
  {
    "id": 36,
    "start": "00:02:14,681",
    "end": "00:02:20,105",
    "text": "Nếu trái tim yêu Allah, bề tôi thật hanh phúc,"
  },
  {
    "id": 37,
    "start": "00:02:20,105",
    "end": "00:02:24,574",
    "text": "Có Ngài đồng hành, còn điều gì phải sợ?"
  },
  {
    "id": 38,
    "start": "00:02:24,574",
    "end": "00:02:26,649",
    "text": "Dẫu cả thế gian quay lưng,"
  },
  {
    "id": 39,
    "start": "00:02:26,649",
    "end": "00:02:29,520",
    "text": "Dẫu mọi cánh cửa khép lại,"
  },
  {
    "id": 40,
    "start": "00:02:29,520",
    "end": "00:02:34,467",
    "text": "Chỉ cần có Allah, bề tôi vẫn còn tất cả."
  },
  {
    "id": 41,
    "start": "00:02:34,467",
    "end": "00:02:36,861",
    "text": "Chỉ cần Allah thôi,"
  },
  {
    "id": 42,
    "start": "00:02:36,861",
    "end": "00:02:40,212",
    "text": "chỉ cần Allah thôi,"
  },
  {
    "id": 43,
    "start": "00:02:40,212",
    "end": "00:02:44,282",
    "text": "Khi yếu mềm, khi mạnh mẽ."
  },
  {
    "id": 44,
    "start": "00:02:44,282",
    "end": "00:02:49,706",
    "text": "Chỉ cần Allah thôi, Allah thôi,"
  },
  {
    "id": 45,
    "start": "00:02:49,706",
    "end": "00:02:52,419",
    "text": "Từ thuở ban đầu, cho đến khi kết thúc."
  }
]
