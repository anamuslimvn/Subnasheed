[
  {
    "id": 1,
    "start": "00:00:16,435",
    "end": "00:00:20,106",
    "text": "Nước mắt rơi, lòng sẽ nhẹ hơn"
  },
  {
    "id": 2,
    "start": "00:00:20,106",
    "end": "00:00:23,617",
    "text": "Cứ khóc đi, rồi sẽ bình yên"
  },
  {
    "id": 3,
    "start": "00:00:23,617",
    "end": "00:00:27,286",
    "text": "Hãy cầu nguyện, dù trong im lặng"
  },
  {
    "id": 4,
    "start": "00:00:27,286",
    "end": "00:00:30,797",
    "text": "Allah nghe, từng tiếng trong tim"
  },
  {
    "id": 5,
    "start": "00:00:30,797",
    "end": "00:00:34,468",
    "text": "Nước mắt rơi, rồi sẽ nhẹ lòng"
  },
  {
    "id": 6,
    "start": "00:00:34,468",
    "end": "00:00:37,978",
    "text": "Những vết đau, rồi sẽ lành thôi"
  },
  {
    "id": 7,
    "start": "00:00:37,978",
    "end": "00:00:41,569",
    "text": "Dẫu hôm nay, còn nhiều mệt mỏi"
  },
  {
    "id": 8,
    "start": "00:00:41,569",
    "end": "00:00:46,884",
    "text": "Ngày mai rồi, sẽ sáng hơn thôi"
  },
  {
    "id": 9,
    "start": "00:00:47,234",
    "end": "00:00:50,664",
    "text": "Nhớ Allah, cuộc đời thêm đẹp"
  },
  {
    "id": 10,
    "start": "00:00:50,664",
    "end": "00:00:54,095",
    "text": "Nhớ Allah, lòng sẽ bình yên"
  },
  {
    "id": 11,
    "start": "00:00:54,095",
    "end": "00:00:57,765",
    "text": "Những nỗi đau, rồi sẽ qua hết"
  },
  {
    "id": 12,
    "start": "00:00:57,765",
    "end": "00:01:01,435",
    "text": "Khi trái tim, hướng về Allah"
  },
  {
    "id": 13,
    "start": "00:01:01,435",
    "end": "00:01:04,947",
    "text": "Nhớ Allah, nụ cười trở lại"
  },
  {
    "id": 14,
    "start": "00:01:04,947",
    "end": "00:01:08,456",
    "text": "Nhớ Allah, lòng sẽ nhẹ hơn"
  },
  {
    "id": 15,
    "start": "00:01:08,456",
    "end": "00:01:11,968",
    "text": "Chỉ cần ta, luôn tin nơi Ngài"
  },
  {
    "id": 16,
    "start": "00:01:11,968",
    "end": "00:01:26,799",
    "text": "Bình minh rồi, sẽ đến trong đời"
  },
  {
    "id": 17,
    "start": "00:01:31,754",
    "end": "00:01:35,266",
    "text": "Đêm rồi cũng sẽ qua đi thôi"
  },
  {
    "id": 18,
    "start": "00:01:35,266",
    "end": "00:01:38,855",
    "text": "Mây rồi cũng sẽ tan trên trời"
  },
  {
    "id": 19,
    "start": "00:01:38,855",
    "end": "00:01:42,527",
    "text": "Hãy đứng lên, sau bao lần ngã"
  },
  {
    "id": 20,
    "start": "00:01:42,527",
    "end": "00:01:46,037",
    "text": "Vì Allah, soi lối ta đi"
  },
  {
    "id": 21,
    "start": "00:01:46,037",
    "end": "00:01:49,628",
    "text": "Con thuyền kia, rồi sẽ về bến"
  },
  {
    "id": 22,
    "start": "00:01:49,628",
    "end": "00:01:53,218",
    "text": "Dẫu ngoài khơi, sóng vẫn còn cao"
  },
  {
    "id": 23,
    "start": "00:01:53,218",
    "end": "00:01:56,888",
    "text": "Hãy trở về, tìm nơi nương tựa"
  },
  {
    "id": 24,
    "start": "00:01:56,888",
    "end": "00:02:01,963",
    "text": "Nơi bình yên, chẳng còn thương đau."
  },
  {
    "id": 25,
    "start": "00:02:02,313",
    "end": "00:02:05,027",
    "text": "Nhớ Allah, cuộc đời thêm đẹp"
  },
  {
    "id": 26,
    "start": "00:02:05,027",
