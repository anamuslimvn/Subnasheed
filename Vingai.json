[
  {
    "id": 1,
    "start": "00:00:19,628",
    "end": "00:00:24,175",
    "text": "Vì Ngài, bề tôi chẳng dừng chân."
  },
  {
    "id": 2,
    "start": "00:00:24,175",
    "end": "00:00:25,611",
    "text": "Đường chông gai"
  },
  {
    "id": 3,
    "start": "00:00:25,611",
    "end": "00:00:27,286",
    "text": "Bỗng hóa dịu êm."
  },
  {
    "id": 4,
    "start": "00:00:27,286",
    "end": "00:00:33,590",
    "text": "Bầy tôi mang theo ánh sáng hidayah,"
  },
  {
    "id": 5,
    "start": "00:00:33,590",
    "end": "00:00:38,457",
    "text": "Lặng lẽ gieo giữa những màn đêm."
  },
  {
    "id": 6,
    "start": "00:00:38,457",
    "end": "00:00:41,968",
    "text": "Và bước theo dấu chân của Muhammad,"
  },
  {
    "id": 7,
    "start": "00:00:41,968",
    "end": "00:00:50,430",
    "text": "Dẫu con đường còn lắm gió sương."
  },
  {
    "id": 8,
    "start": "00:00:52,180",
    "end": "00:00:53,777",
    "text": "Ya Allah"
  },
  {
    "id": 9,
    "start": "00:00:53,777",
    "end": "00:00:54,654",
    "text": "Vì Ngài"
  },
  {
    "id": 10,
    "start": "00:00:54,654",
    "end": "00:00:55,850",
    "text": "Ya Allah"
  },
  {
    "id": 11,
    "start": "00:00:55,850",
    "end": "00:00:55,871",
    "text": "Ya Allah"
  },
  {
    "id": 12,
    "start": "00:00:57,148",
    "end": "00:00:57,667",
    "text": "Vì Ngài"
  },
  {
    "id": 13,
    "start": "00:00:57,926",
    "end": "00:01:02,792",
    "text": "Bầy tôi gọi người về với Allah,"
  },
  {
    "id": 14,
    "start": "00:01:02,792",
    "end": "00:01:07,739",
    "text": "Bằng sự dịu dàng của cơn mưa."
  },
  {
    "id": 15,
    "start": "00:01:07,739",
    "end": "00:01:11,250",
    "text": "Rahmat của Ngài như tầng mây,"
  },
  {
    "id": 16,
    "start": "00:01:11,250",
    "end": "00:01:14,840",
    "text": "Đi qua đâu"
  },
  {
    "id": 17,
    "start": "00:01:14,840",
    "end": "00:01:17,552",
    "text": "Đá cũng biết mềm."
  },
  {
    "id": 18,
    "start": "00:01:17,552",
    "end": "00:01:22,340",
    "text": "Có những trái tim từng khép kín,"
  },
  {
    "id": 19,
    "start": "00:01:22,340",
    "end": "00:01:27,527",
    "text": "Nay mở ra như đất gặp xuân."
  },
  {
    "id": 20,
    "start": "00:01:27,527",
    "end": "00:01:28,245",
    "text": "Ya Allah"
  },
  {
    "id": 21,
    "start": "00:01:28,245",
    "end": "00:01:28,722",
    "text": "Vì Ngài"
  },
  {
    "id": 22,
    "start": "00:01:28,722",
    "end": "00:01:29,920",
    "text": "Ya Allah"
  },
  {
    "id": 23,
    "start": "00:01:29,920",
    "end": "00:01:30,882",
    "text": "Ya Allah"
  },
  {
    "id": 24,
    "start": "00:01:32,632",
    "end": "00:01:33,590",
    "text": "Vì Ngài"
  },
  {
    "id": 25,
    "start": "00:01:33,590",
    "end": "00:01:34,787",
    "text": "Ya Allah"
  },
  {
    "id": 26,
    "start": "00:01:34,787",
    "end": "00:01:36,512",
    "text": "Ya Allah"
  },
  {
    "id": 27,
    "start": "00:01:36,861",
    "end": "00:01:38,697",
    "text": "Đôi mắt rơi lệ"
  },
  {
    "id": 28,
    "start": "00:01:38,697",
    "end": "00:01:40,293",
    "text": "Không vì thế gian."
  },
  {
    "id": 29,
    "start": "00:01:40,293",
    "end": "00:01:46,516",
    "text": "Mà vì Qur'an chạm đến trái tim."
  },
  {
    "id": 30,
    "start": "00:01:46,516",
    "end": "00:01:49,388",
    "text": "Bầy tôi chẳng mong điều gì,"
  },
  {
    "id": 31,
    "start": "00:01:49,388",
    "end": "00:01:51,941",
    "text": "Ngoài phần thưởng Ngài cất giữ."
  },
  {
    "id": 32,
    "start": "00:01:51,941",
    "end": "00:01:53,218",
    "text": "Cứ bước"
  },
  {
    "id": 33,
    "start": "00:01:53,218",
    "end": "00:01:57,206",
    "text": "Cho đến khi chân trời bừng sáng."
  },
  {
    "id": 34,
    "start": "00:01:57,206",
    "end": "00:02:02,233",
    "text": "Cho đến khi ánh sáng Islam,"
  },
  {
    "id": 35,
    "start": "00:02:02,233",
    "end": "00:02:04,787",
    "text": "Nở như bình minh trên mặt đất."
  },
  {
    "id": 36,
    "start": "00:02:04,787",
    "end": "00:02:08,138",
    "text": "Con đường của những người mời gọi,"
  },
  {
    "id": 37,
    "start": "00:02:08,138",
    "end": "00:02:16,197",
    "text": "Không đo bằng dấu chân."
  },
  {
    "id": 38,
    "start": "00:02:16,197",
    "end": "00:02:17,313",
    "text": "Mà đo"
  },
  {
    "id": 39,
    "start": "00:02:17,313",
    "end": "00:02:21,941",
    "text": "Bằng những trái tim được đánh thức."
  },
  {
    "id": 40,
    "start": "00:02:21,941",
    "end": "00:02:23,138",
    "text": "Ya Allah"
  },
  {
    "id": 41,
    "start": "00:02:23,138",
    "end": "00:02:24,335",
    "text": "Ya Allah"
  },
  {
    "id": 42,
    "start": "00:02:24,335",
    "end": "00:02:26,175",
    "text": "Ya Allah"
  },
  {
    "id": 43,
    "start": "00:02:27,925",
    "end": "00:02:28,421",
    "text": "Ya Allah"
  },
  {
    "id": 44,
    "start": "00:02:28,421",
    "end": "00:02:29,122",
    "text": "Vì Ngài"
  },
  {
    "id": 45,
    "start": "00:02:29,122",
    "end": "00:02:29,729",
    "text": "Ya Allah"
  },
  {
    "id": 46,
    "start": "00:02:30,080",
    "end": "00:02:31,754",
    "text": "Vì Ngài"
  },
  {
    "id": 47,
    "start": "00:02:31,754",
    "end": "00:02:33,590",
    "text": "Bầy tôi vẫn bước."
  },
  {
    "id": 48,
    "start": "00:02:33,590",
    "end": "00:02:34,947",
    "text": "Dẫu gió ngược."
  },
  {
    "id": 49,
    "start": "00:02:34,947",
    "end": "00:02:36,543",
    "text": "Dẫu đêm dài."
  },
  {
    "id": 50,
    "start": "00:02:36,543",
    "end": "00:02:40,850",
    "text": "Bởi cuối con đường"
  },
  {
    "id": 51,
    "start": "00:02:40,850",
    "end": "00:02:43,563",
    "text": "Không phải là thế gian."
  },
  {
    "id": 52,
    "start": "00:02:43,563",
    "end": "00:02:44,840",
    "text": "Mà là"
  },
  {
    "id": 53,
    "start": "00:02:44,840",
    "end": "00:02:48,959",
    "text": "Cuộc gặp gỡ với Allah."
  },
  {
    "id": 54,
    "start": "00:02:49,308",
    "end": "00:02:50,824",
    "text": "Subhanallah"
  },
  {
    "id": 55,
    "start": "00:02:50,824",
    "end": "00:03:02,872",
    "text": "La ilaha illallah"
  },
  {
    "id": 56,
    "start": "00:03:02,872",
    "end": "00:03:04,149",
    "text": "Ya Allah"
  },
  {
    "id": 57,
    "start": "00:03:04,149",
    "end": "00:03:05,346",
    "text": "Ya Allah"
  },
  {
    "id": 58,
    "start": "00:03:05,346",
    "end": "00:03:07,739",
    "text": "Ya Allah"
  },
  {
    "id": 59,
    "start": "00:03:07,739",
    "end": "00:03:09,015",
    "text": "Ya Allah"
  },
  {
    "id": 60,
    "start": "00:03:09,015",
    "end": "00:03:10,212",
    "text": "Ya Allah"
  },
  {
    "id": 61,
    "start": "00:03:10,212",
    "end": "00:03:11,569",
    "text": "Ya Allah"
  }
]