[
  {
    "id": 1,
    "start": "00:00:21,782",
    "end": "00:00:24,175",
    "text": "Hướng về đỉnh cao"
  },
  {
    "id": 2,
    "start": "00:00:24,175",
    "end": "00:00:29,202",
    "text": "Bằng đức tin và phẩm hạnh."
  },
  {
    "id": 3,
    "start": "00:00:29,202",
    "end": "00:00:30,957",
    "text": "Hướng về đỉnh cao"
  },
  {
    "id": 4,
    "start": "00:00:30,957",
    "end": "00:00:36,302",
    "text": "Nơi những người chính trực đã đi qua."
  },
  {
    "id": 5,
    "start": "00:00:36,302",
    "end": "00:00:39,972",
    "text": "Không để lại dấu chân"
  },
  {
    "id": 6,
    "start": "00:00:39,972",
    "end": "00:00:41,488",
    "text": "Mà để lại ánh sáng."
  },
  {
    "id": 7,
    "start": "00:00:43,963",
    "end": "00:00:45,798",
    "text": "Subhanallah"
  },
  {
    "id": 8,
    "start": "00:00:45,798",
    "end": "00:00:47,792",
    "text": "Subhanallah"
  },
  {
    "id": 9,
    "start": "00:00:47,792",
    "end": "00:00:49,707",
    "text": "Alhamdulillah"
  },
  {
    "id": 10,
    "start": "00:00:49,707",
    "end": "00:00:51,463",
    "text": "Alhamdulillah"
  },
  {
    "id": 11,
    "start": "00:00:51,463",
    "end": "00:00:53,298",
    "text": "Subhanallah"
  },
  {
    "id": 12,
    "start": "00:00:53,298",
    "end": "00:00:55,213",
    "text": "Subhanallah"
  },
  {
    "id": 13,
    "start": "00:00:55,213",
    "end": "00:00:59,859",
    "text": "Alhamdulillah"
  },
  {
    "id": 14,
    "start": "00:00:59,920",
    "end": "00:01:02,792",
    "text": "Sống với lòng bao dung."
  },
  {
    "id": 15,
    "start": "00:01:02,792",
    "end": "00:01:07,500",
    "text": "Như cơn mưa chẳng chọn nơi để rơi."
  },
  {
    "id": 16,
    "start": "00:01:07,500",
    "end": "00:01:10,293",
    "text": "Bước dưới ánh sáng hidayah."
  },
  {
    "id": 17,
    "start": "00:01:10,293",
    "end": "00:01:13,245",
    "text": "Như bình minh chẳng lạc đường."
  },
  {
    "id": 18,
    "start": "00:01:13,245",
    "end": "00:01:18,350",
    "text": "Mỉm cười trước mọi điều Allah an bài."
  },
  {
    "id": 19,
    "start": "00:01:18,350",
    "end": "00:01:21,861",
    "text": "Vì mỗi định mệnh"
  },
  {
    "id": 20,
    "start": "00:01:21,861",
    "end": "00:01:27,307",
    "text": "Đều mang theo một điều tốt đẹp."
  },
  {
    "id": 21,
    "start": "00:01:30,239",
    "end": "00:01:31,197",
    "text": "Ya Rahman"
  },
  {
    "id": 22,
    "start": "00:01:31,197",
    "end": "00:01:32,153",
    "text": "Ya Rahim"
  },
  {
    "id": 23,
    "start": "00:01:32,153",
    "end": "00:01:33,989",
    "text": "Ya Latif"
  },
  {
    "id": 24,
    "start": "00:01:33,989",
    "end": "00:01:34,947",
    "text": "Ya Rahman"
  },
  {
    "id": 25,
    "start": "00:01:34,947",
    "end": "00:01:35,823",
    "text": "Ya Rahim"
  },
  {
    "id": 26,
    "start": "00:01:35,823",
    "end": "00:01:36,621",
    "text": "Ya Latif"
  },
  {
    "id": 27,
    "start": "00:01:37,260",
    "end": "00:01:39,016",
    "text": "Một lời chân thành."
  },
  {
    "id": 28,
    "start": "00:01:39,016",
    "end": "00:01:43,084",
    "text": "Sống lâu hơn ngàn tiếng vỗ tay."
  },
  {
    "id": 29,
    "start": "00:01:43,084",
    "end": "00:01:44,840",
    "text": "Một việc thiện âm thầm."
  },
  {
    "id": 30,
    "start": "00:01:44,840",
    "end": "00:01:50,504",
    "text": "Sáng hơn ngàn ngọn đèn."
  },
  {
    "id": 31,
    "start": "00:01:50,504",
    "end": "00:01:54,415",
    "text": "Có những con người rời khỏi thế gian."
  },
  {
    "id": 32,
    "start": "00:01:54,415",
    "end": "00:01:58,165",
    "text": "Mà hương thơm của họ"
  },
  {
    "id": 33,
    "start": "00:01:58,165",
    "end": "00:02:02,093",
    "text": "Vẫn còn trong lòng người."
  },
  {
    "id": 34,
    "start": "00:02:02,394",
    "end": "00:02:05,584",
    "text": "La ilaha illallah"
  },
  {
    "id": 35,
    "start": "00:02:05,584",
    "end": "00:02:06,543",
    "text": "Allah"
  },
  {
    "id": 36,
    "start": "00:02:06,543",
    "end": "00:02:10,293",
    "text": "La ilaha illallah"
  },
  {
    "id": 37,
    "start": "00:02:10,293",
    "end": "00:02:12,686",
    "text": "La ilaha illallah"
  },
  {
    "id": 38,
    "start": "00:02:13,962",
    "end": "00:02:14,600",
    "text": "Đừng hỏi"
  },
  {
    "id": 39,
    "start": "00:02:14,600",
    "end": "00:02:20,265",
    "text": "Làm sao chạm tới đỉnh cao."
  },
  {
    "id": 40,
    "start": "00:02:20,265",
    "end": "00:02:24,015",
    "text": "Hãy nhìn cánh chim."
  },
  {
    "id": 41,
    "start": "00:02:24,015",
    "end": "00:02:28,802",
    "text": "Chưa từng ngừng vỗ cánh."
  },
  {
    "id": 42,
    "start": "00:02:28,802",
    "end": "00:02:31,436",
    "text": "Đừng hỏi"
  },
  {
    "id": 43,
    "start": "00:02:31,436",
    "end": "00:02:35,105",
    "text": "Làm sao ánh sáng đi xa."
  },
  {
    "id": 44,
    "start": "00:02:35,105",
    "end": "00:02:38,936",
    "text": "Hãy nhìn ngọn đèn."
  },
  {
    "id": 45,
    "start": "00:02:38,936",
    "end": "00:02:43,343",
    "text": "Âm thầm cháy suốt đêm."
  },
  {
    "id": 46,
    "start": "00:02:47,872",
    "end": "00:02:49,866",
    "text": "Hôm nay gieo một hạt giống."
  },
  {
    "id": 47,
    "start": "00:02:49,866",
    "end": "00:02:51,622",
    "text": "Ngày mai thành bóng cây."
  },
  {
    "id": 48,
    "start": "00:02:51,622",
    "end": "00:02:53,616",
    "text": "Hôm nay mở một nụ cười."
  },
  {
    "id": 49,
    "start": "00:02:53,616",
    "end": "00:02:55,293",
    "text": "Ngày mai thành mùa xuân."
  },
  {
    "id": 50,
    "start": "00:02:55,293",
    "end": "00:02:56,808",
    "text": "Thời gian khép lại."
  },
  {
    "id": 51,
    "start": "00:02:56,808",
    "end": "00:02:57,686",
    "text": "Nhưng việc thiện"
  },
  {
    "id": 52,
    "start": "00:02:57,686",
    "end": "00:03:00,338",
    "text": "Không bao giờ già đi."
  },
  {
    "id": 53,
    "start": "00:03:01,596",
    "end": "00:03:03,270",
    "text": "Alhamdulillah"
  },
  {
    "id": 54,
    "start": "00:03:03,270",
    "end": "00:03:05,664",
    "text": "Subhanallah"
  },
  {
    "id": 55,
    "start": "00:03:05,664",
    "end": "00:03:07,020",
    "text": "Ya Allah"
  },
  {
    "id": 56,
    "start": "00:03:07,020",
    "end": "00:03:09,335",
    "text": "Subhanallah"
  },
  {
    "id": 57,
    "start": "00:03:09,335",
    "end": "00:03:11,189",
    "text": "Ya Allah"
  },
  {
    "id": 58,
    "start": "00:03:11,649",
    "end": "00:03:12,925",
    "text": "Dang rộng đôi tay."
  },
  {
    "id": 59,
    "start": "00:03:12,925",
    "end": "00:03:15,399",
    "text": "Không phải để nhận."
  },
  {
    "id": 60,
    "start": "00:03:15,399",
    "end": "00:03:21,462",
    "text": "Mà để nâng một người đang ngã."
  },
  {
    "id": 61,
    "start": "00:03:21,462",
    "end": "00:03:23,058",
    "text": "Đó là con đường."
  },
  {
    "id": 62,
    "start": "00:03:23,058",
    "end": "00:03:24,734",
    "text": "Mà những người đi trước"
  },
  {
    "id": 63,
    "start": "00:03:24,734",
    "end": "00:03:27,147",
    "text": "Đã để lại."
  },
  {
    "id": 64,
    "start": "00:03:27,925",
    "end": "00:03:29,361",
    "text": "Hướng về đỉnh cao"
  },
  {
    "id": 65,
    "start": "00:03:29,361",
    "end": "00:03:31,436",
    "text": "Không phải để được nhìn thấy."
  },
  {
    "id": 66,
    "start": "00:03:31,436",
    "end": "00:03:35,346",
    "text": "Mà để nhìn thấy Allah trong từng ân phước."
  },
  {
    "id": 67,
    "start": "00:03:35,346",
    "end": "00:03:36,782",
    "text": "Hướng về đỉnh cao"
  },
  {
    "id": 68,
    "start": "00:03:36,782",
    "end": "00:03:37,580",
    "text": "Cho đến khi"
  },
  {
    "id": 69,
    "start": "00:03:37,580",
    "end": "00:03:38,537",
    "text": "Mỗi bước chân."
  },
  {
    "id": 70,
    "start": "00:03:38,537",
    "end": "00:03:40,372",
    "text": "Đều trở thành một lời du'a."
  },
  {
    "id": 71,
    "start": "00:03:43,245",
    "end": "00:03:46,276",
    "text": "La ilaha illallah"
  },
  {
    "id": 72,
    "start": "00:03:46,276",
    "end": "00:03:49,706",
    "text": "Subhanallah"
  },
  {
    "id": 73,
    "start": "00:03:49,706",
    "end": "00:03:54,015",
    "text": "Alhamdulillah"
  },
  {
    "id": 74,
    "start": "00:03:54,015",
    "end": "00:03:55,212",
    "text": "Ya Allah"
  },
  {
    "id": 75,
    "start": "00:03:57,686",
    "end": "00:04:00,717",
    "text": "Ngày rồi sẽ qua"
  },
  {
    "id": 76,
    "start": "00:04:00,717",
    "end": "00:04:04,947",
    "text": "Tên người rồi sẽ phai"
  },
  {
    "id": 77,
    "start": "00:04:04,947",
    "end": "00:04:12,605",
    "text": "Chỉ những việc làm vì Allah"
  },
  {
    "id": 78,
    "start": "00:04:12,605",
    "end": "00:04:14,441",
    "text": "Vẫn còn mãi"
  }
]