[
  {
    "id": 1,
    "start": "00:00:04,229",
    "end": "00:00:09,573",
    "text": "Allah"
  },
  {
    "id": 2,
    "start": "00:00:09,573",
    "end": "00:00:11,569",
    "text": "Ya Rahman"
  },
  {
    "id": 3,
    "start": "00:00:11,569",
    "end": "00:00:27,894",
    "text": "Ya Rahim"
  },
  {
    "id": 4,
    "start": "00:00:28,245",
    "end": "00:00:31,515",
    "text": "Ngày ấy chẳng còn một bóng cây,"
  },
  {
    "id": 5,
    "start": "00:00:31,515",
    "end": "00:00:34,866",
    "text": "Để che đi những điều đã làm."
  },
  {
    "id": 6,
    "start": "00:00:34,866",
    "end": "00:00:38,218",
    "text": "Không một lời có thể chối bỏ,"
  },
  {
    "id": 7,
    "start": "00:00:38,218",
    "end": "00:00:40,531",
    "text": "Không một bí mật còn giấu được."
  },
  {
    "id": 8,
    "start": "00:00:40,531",
    "end": "00:00:45,000",
    "text": "Mỗi bước chân đều mang nhân chứng,"
  },
  {
    "id": 9,
    "start": "00:00:45,000",
    "end": "00:00:48,430",
    "text": "Mỗi việc làm đều được phơi bày."
  },
  {
    "id": 10,
    "start": "00:00:48,430",
    "end": "00:00:51,862",
    "text": "Người từng quên Allah giữa cuộc đời,"
  },
  {
    "id": 11,
    "start": "00:00:51,862",
    "end": "00:00:55,341",
    "text": "Giờ chỉ biết cúi đầu lặng im."
  },
  {
    "id": 12,
    "start": "00:01:02,472",
    "end": "00:01:05,903",
    "text": "Có những khuôn mặt bừng ánh sáng,"
  },
  {
    "id": 13,
    "start": "00:01:05,903",
    "end": "00:01:08,537",
    "text": "Có những khuôn mặt phủ bóng đêm."
  },
  {
    "id": 14,
    "start": "00:01:08,537",
    "end": "00:01:12,766",
    "text": "Có người bình an trong hy vọng,"
  },
  {
    "id": 15,
    "start": "00:01:12,766",
    "end": "00:01:17,153",
    "text": "Có người run rẩy vì hối tiếc."
  },
  {
    "id": 16,
    "start": "00:01:17,153",
    "end": "00:01:18,829",
    "text": "Từng là hàng xóm"
  },
  {
    "id": 17,
    "start": "00:01:18,829",
    "end": "00:01:20,504",
    "text": "Từng là bạn bè"
  },
  {
    "id": 18,
    "start": "00:01:20,504",
    "end": "00:01:26,728",
    "text": "Từng đứng cạnh nhau nơi trần thế"
  },
  {
    "id": 19,
    "start": "00:01:26,728",
    "end": "00:01:31,884",
    "text": "Nhưng hôm nay chẳng còn như trước."
  },
  {
    "id": 20,
    "start": "00:01:32,233",
    "end": "00:01:35,266",
    "text": "Rồi một bức tường được dựng lên"
  },
  {
    "id": 21,
    "start": "00:01:35,266",
    "end": "00:01:38,138",
    "text": "Ngăn hai con đường không bao giờ gặp lại."
  },
  {
    "id": 22,
    "start": "00:01:38,138",
    "end": "00:01:42,367",
    "text": "Phía này là hồng ân của Allah."
  },
  {
    "id": 23,
    "start": "00:01:42,367",
    "end": "00:01:46,596",
    "text": "Phía kia là nỗi ân hận muộn màng."
  },
  {
    "id": 24,
    "start": "00:01:46,596",
    "end": "00:01:49,228",
    "text": "Tiếng gọi nghẹn ngào vang lên:"
  },
  {
    "id": 25,
    "start": "00:01:49,228",
    "end": "00:01:52,978",
    "text": "\"Chẳng phải chúng ta đã từng ở cùng nhau sao?\""
  },
  {
    "id": 26,
    "start": "00:01:52,978",
    "end": "00:01:56,170",
    "text": "Nhưng cánh cổng đã khép lại"
  },
  {
    "id": 27,
    "start": "00:01:56,170",
    "end": "00:01:58,962",
    "text": "Và thời gian"
  },
  {
    "id": 28,
    "start": "00:02:02,840",
    "end": "00:02:02,840",
    "text": "Không quay trở lại."
  },
  {
    "id": 29,
    "start": "00:02:16,355",
    "end": "00:02:19,706",
    "text": "Không phải vì Allah bất công"
  },
  {
    "id": 30,
    "start": "00:02:19,706",
    "end": "00:02:23,138",
    "text": "Mà vì bao lần chân lý bị khước từ."
  },
  {
    "id": 31,
    "start": "00:02:23,138",
    "end": "00:02:26,489",
    "text": "Không phải vì cánh cửa quá hẹp"
  },
  {
    "id": 32,
    "start": "00:02:26,489",
    "end": "00:02:30,239",
    "text": "Mà vì trái tim đã tự khép lại."
  },
  {
    "id": 33,
    "start": "00:02:30,239",
    "end": "00:02:33,669",
    "text": "Hôm nay còn lời nhắc nhở."
  },
  {
    "id": 34,
    "start": "00:02:33,669",
    "end": "00:02:37,468",
    "text": "Ngày ấy chỉ còn phán quyết."
  },
  {
    "id": 35,
    "start": "00:02:37,818",
    "end": "00:02:42,526",
    "text": "Ya Allah"
  },
  {
    "id": 36,
    "start": "00:02:42,526",
    "end": "00:02:47,633",
    "text": "Xin đừng để bầy tôi đứng phía sau bức tường ấy."
  },
  {
    "id": 37,
    "start": "00:02:47,633",
    "end": "00:02:52,340",
    "text": "Xin giữ vững đức tin trong tim bầy tôi,"
  },
  {
    "id": 38,
    "start": "00:02:52,340",
    "end": "00:02:56,169",
    "text": "Cho đến hơi thở cuối cùng."
  },
  {
    "id": 39,
    "start": "00:02:56,169",
    "end": "00:02:57,765",
    "text": "Ya Allah"
  },
  {
    "id": 40,
    "start": "00:03:01,197",
    "end": "00:03:01,197",
    "text": "Xin ban ánh sáng trong Ngày Sau."
  },
  {
    "id": 41,
    "start": "00:03:01,197",
    "end": "00:03:04,706",
    "text": "Để khi mọi cánh cửa đều khép lại,"
  },
  {
    "id": 42,
    "start": "00:03:04,706",
    "end": "00:03:12,336",
    "text": "Bầy tôi được bước vào nơi Ngài thương xót."
  },
  {
    "id": 43,
    "start": "00:03:12,686",
    "end": "00:03:14,361",
    "text": "Allah"
  },
  {
    "id": 44,
    "start": "00:03:14,361",
    "end": "00:03:15,717",
    "text": "Allah"
  },
  {
    "id": 45,
    "start": "00:03:15,717",
    "end": "00:03:17,394",
    "text": "Ya Rahman"
  },
  {
    "id": 46,
    "start": "00:03:17,394",
    "end": "00:03:26,378",
    "text": "Ya Rahim"
  },
  {
    "id": 47,
    "start": "00:03:33,431",
    "end": "00:03:37,340",
    "text": "Hôm nay"
  },
  {
    "id": 48,
    "start": "00:03:37,340",
    "end": "00:03:47,234",
    "text": "Bức tường ấy vẫn chưa được dựng lên."
  },
  {
    "id": 49,
    "start": "00:03:47,234",
    "end": "00:03:55,212",
    "text": "Vẫn còn thời gian để trở về"
  },
  {
    "id": 50,
    "start": "00:03:55,212",
    "end": "00:03:56,967",
    "text": "Trước khi"
  },
  {
    "id": 51,
    "start": "00:03:56,967",
    "end": "00:04:00,318",
    "text": "Không còn phía bên này nữa."
  }
]