[
  {
    "id": 1,
    "start": "00:00:13,803",
    "end": "00:00:21,702",
    "text": "Bạn hỏi tôi: “Bao giờ đời sẽ nhẹ nhàng?"
  },
  {
    "id": 2,
    "start": "00:00:21,702",
    "end": "00:00:27,128",
    "text": "Bao giờ bóng tối sẽ đi qua?"
  },
  {
    "id": 3,
    "start": "00:00:27,128",
    "end": "00:00:33,430",
    "text": "Bao năm rồi, lòng còn mỏi mệt,"
  },
  {
    "id": 4,
    "start": "00:00:33,430",
    "end": "00:00:40,052",
    "text": "Biết đến khi nào mới được bình yên?”"
  },
  {
    "id": 5,
    "start": "00:00:40,052",
    "end": "00:00:43,643",
    "text": "Tôi nói: “Bạn ơi, đừng buồn nữa,"
  },
  {
    "id": 6,
    "start": "00:00:43,643",
    "end": "00:00:47,073",
    "text": "Allah luôn biết những tháng ngày."
  },
  {
    "id": 7,
    "start": "00:00:47,073",
    "end": "00:00:50,904",
    "text": "Hãy làm điều tốt dù rất nhỏ,"
  },
  {
    "id": 8,
    "start": "00:00:50,904",
    "end": "00:00:56,060",
    "text": "Rồi bình minh sẽ đến một ngày.”"
  },
  {
    "id": 9,
    "start": "00:01:10,132",
    "end": "00:01:13,722",
    "text": "Hãy là hy vọng giữa cuộc đời,"
  },
  {
    "id": 10,
    "start": "00:01:13,722",
    "end": "00:01:17,073",
    "text": "Trao lời yêu thương đến mọi người."
  },
  {
    "id": 11,
    "start": "00:01:17,073",
    "end": "00:01:20,426",
    "text": "Một lời tử tế, một bàn tay,"
  },
  {
    "id": 12,
    "start": "00:01:20,426",
    "end": "00:01:23,697",
    "text": "Có thể xoa dịu một trái tim."
  },
  {
    "id": 13,
    "start": "00:01:23,697",
    "end": "00:01:26,968",
    "text": "Hãy làm điều tốt vì Allah,"
  },
  {
    "id": 14,
    "start": "00:01:26,968",
    "end": "00:01:29,840",
    "text": "Đừng chờ cuộc sống hết phong ba."
  },
  {
    "id": 15,
    "start": "00:01:29,840",
    "end": "00:01:33,750",
    "text": "Khi bạn gieo thiện giữa nhân gian,"
  },
  {
    "id": 16,
    "start": "00:01:33,750",
    "end": "00:01:38,825",
    "text": "Allah ban phước đến cho bạn."
  },
  {
    "id": 17,
    "start": "00:01:53,617",
    "end": "00:01:58,323",
    "text": "Nếu đời hôm nay còn nhiều giông tố,"
  },
  {
    "id": 18,
    "start": "00:01:58,323",
    "end": "00:02:07,500",
    "text": "Thì hãy bình tâm bước tiếp thôi."
  },
  {
    "id": 19,
    "start": "00:02:07,500",
    "end": "00:02:13,723",
    "text": "Giữ Salah, giữ lòng Taqwa,"
  },
  {
    "id": 20,
    "start": "00:02:13,723",
    "end": "00:02:20,504",
    "text": "Đừng để ưu phiền lấy mất niềm tin."
  },
  {
    "id": 21,
    "start": "00:02:20,504",
    "end": "00:02:24,015",
    "text": "Có khi hạnh phúc không xa lắm,"
  },
  {
    "id": 22,
    "start": "00:02:24,015",
    "end": "00:02:27,526",
    "text": "Chỉ nằm trong một việc thiện lành."
  },
  {
    "id": 23,
    "start": "00:02:27,526",
    "end": "00:02:30,159",
    "text": "Khi bạn khiến một người vui lại,"
  },
  {
    "id": 24,
    "start": "00:02:30,159",
    "end": "00:02:34,915",
    "text": "Lòng bạn cũng sẽ thấy bình an."
  },
  {
    "id": 25,
    "start": "00:02:39,254",
    "end": "00:02:45,877",
    "text": "Đừng hỏi khi nào đời hết đau,"
  },
  {
    "id": 26,
    "start": "00:02:45,877",
    "end": "00:02:50,585",
    "text": "Hãy hỏi hôm nay mình làm gì."
  },
  {
    "id": 27,
    "start": "00:02:50,585",
    "end": "00:02:57,127",
    "text": "Để một trái tim đang buồn bã,"
  },
  {
    "id": 28,
    "start": "00:02:57,127",
    "end": "00:03:03,560",
    "text": "Tìm lại hy vọng nơi Allah"
  },
  {
    "id": 29,
    "start": "00:03:03,909",
    "end": "00:03:07,500",
    "text": "Hãy là hy vọng giữa cuộc đời,"
  },
  {
    "id": 30,
    "start": "00:03:07,500",
    "end": "00:03:10,850",
    "text": "Trao lời yêu thương đến mọi người."
  },
  {
    "id": 31,
    "start": "00:03:10,850",
    "end": "00:03:14,201",
    "text": "Một lời tử tế, một bàn tay,"
  },
  {
    "id": 32,
    "start": "00:03:14,201",
    "end": "00:03:17,394",
    "text": "Có thể xoa dịu một trái tim."
  },
  {
    "id": 33,
    "start": "00:03:17,394",
    "end": "00:03:20,745",
    "text": "Hãy làm điều tốt vì Allah,"
  },
  {
    "id": 34,
    "start": "00:03:20,745",
    "end": "00:03:24,175",
    "text": "Dẫu đường phía trước vẫn phong ba."
  },
  {
    "id": 35,
    "start": "00:03:24,175",
    "end": "00:03:28,085",
    "text": "Ngày mai nếu chẳng còn gặp lại,"
  },
  {
    "id": 36,
    "start": "00:03:28,085",
    "end": "00:03:36,670",
    "text": "Thiện lành vẫn ở lại nơi đây."
  },
  {
    "id": 37,
    "start": "00:03:37,818",
    "end": "00:03:41,090",
    "text": "Hãy là niềm hy vọng"
  },
  {
    "id": 38,
    "start": "00:03:41,090",
    "end": "00:03:48,270",
    "text": "Hãy là điều tốt giữa cuộc đời"
  },
  {
    "id": 39,
    "start": "00:03:48,270",
    "end": "00:03:54,973",
    "text": "Alhamdulillah"
  },
  {
    "id": 40,
    "start": "00:03:54,973",
    "end": "00:03:58,524",
    "text": "Alhamdulillah"
  }
]