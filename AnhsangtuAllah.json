[
  {
    "id": 1,
    "start": "00:00:06,144",
    "end": "00:00:11,169",
    "text": "Ya Allah"
  },
  {
    "id": 2,
    "start": "00:00:11,169",
    "end": "00:00:15,798",
    "text": "Chỉ khi nhớ đến Ngài"
  },
  {
    "id": 3,
    "start": "00:00:15,798",
    "end": "00:00:21,193",
    "text": "Trái tim mới bình yên"
  },
  {
    "id": 4,
    "start": "00:00:21,542",
    "end": "00:00:27,765",
    "text": "Đời đẹp hơn khi còn nhớ Allah,"
  },
  {
    "id": 5,
    "start": "00:00:27,765",
    "end": "00:00:33,271",
    "text": "Như bình minh chạm đến màn đêm."
  },
  {
    "id": 6,
    "start": "00:00:33,271",
    "end": "00:00:37,978",
    "text": "Ánh sáng của Ngài rọi vào tim,"
  },
  {
    "id": 7,
    "start": "00:00:37,978",
    "end": "00:00:43,484",
    "text": "Làm dịu những tháng ngày khô cạn."
  },
  {
    "id": 8,
    "start": "00:00:43,484",
    "end": "00:00:47,552",
    "text": "Có một trái tim luôn hướng về Ngài,"
  },
  {
    "id": 9,
    "start": "00:00:47,552",
    "end": "00:00:56,569",
    "text": "Khát khao ngày được gặp Allah."
  },
  {
    "id": 10,
    "start": "00:00:56,569",
    "end": "00:01:01,356",
    "text": "Dẫu bước qua ngàn dốc núi,"
  },
  {
    "id": 11,
    "start": "00:01:01,356",
    "end": "00:01:06,512",
    "text": "Vẫn tìm nơi bình yên để dừng chân."
  },
  {
    "id": 12,
    "start": "00:01:18,829",
    "end": "00:01:24,733",
    "text": "Ôi Allah bề tôi cần Ngài,"
  },
  {
    "id": 13,
    "start": "00:01:24,733",
    "end": "00:01:30,209",
    "text": "Ôi Allah bề tôi cần Ngài."
  },
  {
    "id": 14,
    "start": "00:01:30,558",
    "end": "00:01:36,382",
    "text": "Không cuộc vui nào giữ chân được,"
  },
  {
    "id": 15,
    "start": "00:01:36,382",
    "end": "00:01:42,128",
    "text": "Không vàng bạc nào làm mờ đôi mắt."
  },
  {
    "id": 16,
    "start": "00:01:42,128",
    "end": "00:01:45,956",
    "text": "Khi lời mời của Salah cất lên,"
  },
  {
    "id": 17,
    "start": "00:01:45,956",
    "end": "00:01:53,218",
    "text": "Trái tim đã bước trước đôi chân."
  },
  {
    "id": 18,
    "start": "00:01:53,218",
    "end": "00:01:56,728",
    "text": "Ôi Allah"
  },
  {
    "id": 19,
    "start": "00:01:56,728",
    "end": "00:02:02,203",
    "text": "Mọi nẻo đường đều dẫn về Ngài."
  },
  {
    "id": 20,
    "start": "00:02:02,552",
    "end": "00:02:05,504",
    "text": "Bờ môi khẽ gọi trong màn đêm:"
  },
  {
    "id": 21,
    "start": "00:02:05,504",
    "end": "00:02:06,861",
    "text": "\"Ya Rabb"
  },
  {
    "id": 22,
    "start": "00:02:06,861",
    "end": "00:02:12,366",
    "text": "Xin tha thứ cho bề tôi\""
  },
  {
    "id": 23,
    "start": "00:02:12,366",
    "end": "00:02:15,318",
    "text": "Một giọt lệ rơi trên mí mắt,"
  },
  {
    "id": 24,
    "start": "00:02:15,318",
    "end": "00:02:19,388",
    "text": "Lặng lẽ cuốn trôi lớp bụi trong tim."
  },
  {
    "id": 25,
    "start": "00:02:19,388",
    "end": "00:02:27,366",
    "text": "Trái tim sống vì nhớ đến Allah,"
  },
  {
    "id": 26,
    "start": "00:02:27,366",
    "end": "00:02:33,032",
    "text": "Như cối xay không ngừng quay."
  },
  {
    "id": 27,
    "start": "00:02:33,032",
    "end": "00:02:34,866",
    "text": "Mỗi nhịp đập"
  },
  {
    "id": 28,
    "start": "00:02:34,866",
    "end": "00:02:38,616",
    "text": "Đều hướng về Ngài."
  },
  {
    "id": 29,
    "start": "00:02:38,616",
    "end": "00:02:39,544",
    "text": "\"Ya Allah\""
  },
  {
    "id": 30,
    "start": "00:02:44,201",
    "end": "00:02:53,537",
    "text": "Phúc thay người mang chí lớn,"
  },
  {
    "id": 31,
    "start": "00:02:53,537",
    "end": "00:02:56,330",
    "text": "Chẳng đổi Jannah lấy thế gian."
  },
  {
    "id": 32,
    "start": "00:02:56,330",
    "end": "00:02:58,164",
    "text": "Mỗi bước đi"
  },
  {
    "id": 33,
    "start": "00:02:58,164",
    "end": "00:03:02,153",
    "text": "Đều gần Allah hơn."
  },
  {
    "id": 34,
    "start": "00:03:02,153",
    "end": "00:03:03,909",
    "text": "Mỗi hơi thở"
  },
  {
    "id": 35,
    "start": "00:03:03,909",
    "end": "00:03:06,911",
    "text": "Đều mong ngày gặp Ngài."
  },
  {
    "id": 36,
    "start": "00:03:07,260",
    "end": "00:03:09,096",
    "text": "Subhanallah"
  },
  {
    "id": 37,
    "start": "00:03:09,096",
    "end": "00:03:10,931",
    "text": "Alhamdulillah"
  },
  {
    "id": 38,
    "start": "00:03:10,931",
    "end": "00:03:13,484",
    "text": "La ilaha illallah"
  },
  {
    "id": 39,
    "start": "00:03:13,484",
    "end": "00:03:14,919",
    "text": "Subhanallah"
  },
  {
    "id": 40,
    "start": "00:03:14,919",
    "end": "00:03:16,754",
    "text": "Alhamdulillah"
  },
  {
    "id": 41,
    "start": "00:03:16,754",
    "end": "00:03:18,750",
    "text": "La ilaha illallah"
  },
  {
    "id": 42,
    "start": "00:03:18,750",
    "end": "00:03:20,186",
    "text": "Subhanallah"
  },
  {
    "id": 43,
    "start": "00:03:20,186",
    "end": "00:03:22,659",
    "text": "Alhamdulillah"
  },
  {
    "id": 44,
    "start": "00:03:22,659",
    "end": "00:03:25,133",
    "text": "La ilaha illallah"
  },
  {
    "id": 45,
    "start": "00:03:25,133",
    "end": "00:03:26,568",
    "text": "Subhanallah"
  },
  {
    "id": 46,
    "start": "00:03:26,568",
    "end": "00:03:28,403",
    "text": "Alhamdulillah"
  },
  {
    "id": 47,
    "start": "00:03:28,403",
    "end": "00:03:30,847",
    "text": "La ilaha illallah"
  },
  {
    "id": 48,
    "start": "00:03:56,330",
    "end": "00:04:00,798",
    "text": "Đời này rồi sẽ khép lại"
  },
  {
    "id": 49,
    "start": "00:04:00,798",
    "end": "00:04:04,388",
    "text": "Chỉ ánh sáng của Allah"
  },
  {
    "id": 50,
    "start": "00:04:04,388",
    "end": "00:04:07,340",
    "text": "Còn mãi trong tim."
  }
]