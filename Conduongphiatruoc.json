[
  {
    "id": 1,
    "start": "00:00:20,346",
    "end": "00:00:25,452",
    "text": "Trời còn tối đã bước ra đi,"
  },
  {
    "id": 2,
    "start": "00:00:25,452",
    "end": "00:00:30,638",
    "text": "Mang theo bao nỗi lo trong lòng."
  },
  {
    "id": 3,
    "start": "00:00:30,638",
    "end": "00:00:35,426",
    "text": "Đường phía trước dài như vô tận,"
  },
  {
    "id": 4,
    "start": "00:00:35,426",
    "end": "00:00:40,420",
    "text": "Chỉ Allah thấu hết những điều riêng."
  },
  {
    "id": 5,
    "start": "00:00:40,771",
    "end": "00:00:45,798",
    "text": "Có những ngày bàn tay chai sạn,"
  },
  {
    "id": 6,
    "start": "00:00:45,798",
    "end": "00:00:50,904",
    "text": "Mồ hôi rơi chẳng đếm bao lần."
  },
  {
    "id": 7,
    "start": "00:00:50,904",
    "end": "00:00:54,335",
    "text": "Gánh cơm áo nặng trên đôi vai,"
  },
  {
    "id": 8,
    "start": "00:00:54,335",
    "end": "00:01:00,368",
    "text": "Vẫn âm thầm chẳng một lời than."
  },
  {
    "id": 9,
    "start": "00:01:00,718",
    "end": "00:01:02,871",
    "text": "Ya Allah..."
  },
  {
    "id": 10,
    "start": "00:01:02,871",
    "end": "00:01:08,855",
    "text": "Khi đôi chân đã mỏi mệt rồi."
  },
  {
    "id": 11,
    "start": "00:01:08,855",
    "end": "00:01:13,722",
    "text": "Xin ban sức mạnh cho bầy tôi,"
  },
  {
    "id": 12,
    "start": "00:01:13,722",
    "end": "00:01:18,510",
    "text": "Để tiếp tục bước trên đường đời."
  },
  {
    "id": 13,
    "start": "00:01:18,510",
    "end": "00:01:20,346",
    "text": "Ya Allah..."
  },
  {
    "id": 14,
    "start": "00:01:20,346",
    "end": "00:01:23,617",
    "text": "Khi trái tim chất đầy âu lo."
  },
  {
    "id": 15,
    "start": "00:01:23,617",
    "end": "00:01:31,834",
    "text": "Xin cho bầy tôi luôn ghi nhớ,"
  },
  {
    "id": 16,
    "start": "00:01:31,834",
    "end": "00:01:36,671",
    "text": "Mọi thử thách đều thuộc về Ngài."
  },
  {
    "id": 17,
    "start": "00:01:37,021",
    "end": "00:01:42,128",
    "text": "Có những đêm thao thức lặng im,"
  },
  {
    "id": 18,
    "start": "00:01:42,128",
    "end": "00:01:47,153",
    "text": "Bao dự định vẫn còn dang dở."
  },
  {
    "id": 19,
    "start": "00:01:47,153",
    "end": "00:01:52,260",
    "text": "Người đời chỉ nhìn thấy nụ cười,"
  },
  {
    "id": 20,
    "start": "00:01:52,260",
    "end": "00:01:57,655",
    "text": "Đâu thấy được những giọt lệ rơi."
  },
  {
    "id": 21,
    "start": "00:01:58,004",
    "end": "00:02:03,111",
    "text": "Rizq nằm trong tay Allah,"
  },
  {
    "id": 22,
    "start": "00:02:03,111",
    "end": "00:02:07,579",
    "text": "Mọi điều đều có thời điểm."
  },
  {
    "id": 23,
    "start": "00:02:07,579",
    "end": "00:02:11,808",
    "text": "Điều hôm nay chưa thể đạt được,"
  },
  {
    "id": 24,
    "start": "00:02:11,808",
    "end": "00:02:16,883",
    "text": "Biết đâu là điều tốt cho ngày sau."
  },
  {
    "id": 25,
    "start": "00:02:17,234",
    "end": "00:02:18,989",
    "text": "Ya Allah..."
  },
  {
    "id": 26,
    "start": "00:02:18,989",
    "end": "00:02:22,340",
    "text": "Nếu con đường còn nhiều gian nan."
  },
  {
    "id": 27,
    "start": "00:02:22,340",
    "end": "00:02:30,638",
    "text": "Xin cho bầy tôi luôn kiên định,"
  },
  {
    "id": 28,
    "start": "00:02:30,638",
    "end": "00:02:35,105",
    "text": "Không đánh mất niềm tin nơi Ngài."
  },
  {
    "id": 29,
    "start": "00:02:35,105",
    "end": "00:02:36,941",
    "text": "Ya Allah..."
  },
  {
    "id": 30,
    "start": "00:02:36,941",
    "end": "00:02:43,085",
    "text": "Dẫu cuộc đời đổi thay từng ngày."
  },
  {
    "id": 31,
    "start": "00:02:43,085",
    "end": "00:02:48,431",
    "text": "Chỉ mong khi nhắm mắt xuôi tay,"
  },
  {
    "id": 32,
    "start": "00:02:48,431",
    "end": "00:02:53,347",
    "text": "Được gặp Ngài với trái tim bình an."
  },
  {
    "id": 33,
    "start": "00:02:53,697",
    "end": "00:02:56,409",
    "text": "Allah... Allah..."
  },
  {
    "id": 34,
    "start": "00:02:56,409",
    "end": "00:03:00,000",
    "text": "Ya Rahman..."
  },
  {
    "id": 35,
    "start": "00:03:00,000",
    "end": "00:03:04,117",
    "text": "Ya Rahim..."
  },
  {
    "id": 36,
    "start": "00:03:14,919",
    "end": "00:03:20,026",
    "text": "Sau mỗi thử thách là bài học,"
  },
  {
    "id": 37,
    "start": "00:03:20,026",
    "end": "00:03:23,377",
    "text": "Sau mỗi khó khăn là hồng ân."
  },
  {
    "id": 38,
    "start": "00:03:23,377",
    "end": "00:03:30,318",
    "text": "Người kiên nhẫn rồi sẽ thấy được,"
  },
  {
    "id": 39,
    "start": "00:03:30,318",
    "end": "00:03:38,665",
    "text": "Lòng thương xót của Allah rộng lớn nhường nào."
  }
]