[
  {
    "id": 1,
    "start": "00:00:04,309",
    "end": "00:00:09,255",
    "text": "Ya Allah"
  },
  {
    "id": 2,
    "start": "00:00:09,255",
    "end": "00:00:14,121",
    "text": "Ya Allah"
  },
  {
    "id": 3,
    "start": "00:00:14,121",
    "end": "00:00:23,506",
    "text": "Ya Allah"
  },
  {
    "id": 4,
    "start": "00:00:23,856",
    "end": "00:00:29,121",
    "text": "Xin cho bề tôi như cánh chim,"
  },
  {
    "id": 5,
    "start": "00:00:29,121",
    "end": "00:00:33,909",
    "text": "Không ngừng bay về phía bầu trời."
  },
  {
    "id": 6,
    "start": "00:00:33,909",
    "end": "00:00:38,856",
    "text": "Xin cho nụ cười như cơn mưa,"
  },
  {
    "id": 7,
    "start": "00:00:38,856",
    "end": "00:00:42,366",
    "text": "Làm dịu những trái tim khô cằn."
  },
  {
    "id": 8,
    "start": "00:00:42,366",
    "end": "00:00:49,069",
    "text": "Xin cho bề tôi như ngọn đèn,"
  },
  {
    "id": 9,
    "start": "00:00:49,069",
    "end": "00:00:53,585",
    "text": "Lặng lẽ sáng giữa màn đêm."
  },
  {
    "id": 10,
    "start": "00:01:03,112",
    "end": "00:01:05,584",
    "text": "Ya Allah"
  },
  {
    "id": 11,
    "start": "00:01:05,584",
    "end": "00:01:08,058",
    "text": "Ya Allah"
  },
  {
    "id": 12,
    "start": "00:01:08,058",
    "end": "00:01:08,905",
    "text": "Ya Allah"
  },
  {
    "id": 13,
    "start": "00:01:09,254",
    "end": "00:01:15,000",
    "text": "Nếu là dòng sông,"
  },
  {
    "id": 14,
    "start": "00:01:15,000",
    "end": "00:01:17,793",
    "text": "Xin chảy về điều thiện."
  },
  {
    "id": 15,
    "start": "00:01:17,793",
    "end": "00:01:19,867",
    "text": "Nếu là hàng cây,"
  },
  {
    "id": 16,
    "start": "00:01:19,867",
    "end": "00:01:22,899",
    "text": "Xin tỏa bóng bình yên."
  },
  {
    "id": 17,
    "start": "00:01:22,899",
    "end": "00:01:26,888",
    "text": "Mọi bước chân"
  },
  {
    "id": 18,
    "start": "00:01:26,888",
    "end": "00:01:32,362",
    "text": "Đều hướng về Allah."
  },
  {
    "id": 19,
    "start": "00:01:32,712",
    "end": "00:01:38,298",
    "text": "Xin cho đôi tay biết cho đi,"
  },
  {
    "id": 20,
    "start": "00:01:38,298",
    "end": "00:01:41,090",
    "text": "Như mây chẳng giữ cơn mưa."
  },
  {
    "id": 21,
    "start": "00:01:41,090",
    "end": "00:01:47,552",
    "text": "Xin cho trái tim luôn khiêm nhường,"
  },
  {
    "id": 22,
    "start": "00:01:47,552",
    "end": "00:01:52,420",
    "text": "Như đất lặng im đón hạt giống."
  },
  {
    "id": 23,
    "start": "00:01:52,420",
    "end": "00:01:57,287",
    "text": "Để khi rời khỏi thế gian,"
  },
  {
    "id": 24,
    "start": "00:01:57,287",
    "end": "00:02:00,367",
    "text": "Vẫn còn hương thơm của việc thiện."
  },
  {
    "id": 25,
    "start": "00:02:14,441",
    "end": "00:02:16,754",
    "text": "Ya Allah"
  },
  {
    "id": 26,
    "start": "00:02:16,754",
    "end": "00:02:19,068",
    "text": "Ya Allah"
  },
  {
    "id": 27,
    "start": "00:02:19,068",
    "end": "00:02:22,310",
    "text": "Ya Allah"
  },
  {
    "id": 28,
    "start": "00:02:22,659",
    "end": "00:02:27,366",
    "text": "Xin cho cuộc đời bề tôi,"
  },
  {
    "id": 29,
    "start": "00:02:27,366",
    "end": "00:02:32,473",
    "text": "Như cánh chim tìm được tổ."
  },
  {
    "id": 30,
    "start": "00:02:32,473",
    "end": "00:02:36,462",
    "text": "Sau hành trình dài"
  },
  {
    "id": 31,
    "start": "00:02:36,462",
    "end": "00:02:38,217",
    "text": "Được trở về"
  },
  {
    "id": 32,
    "start": "00:02:38,217",
    "end": "00:02:47,203",
    "text": "Với Allah."
  },
  {
    "id": 33,
    "start": "00:02:47,552",
    "end": "00:02:49,068",
    "text": "Subhanallah"
  },
  {
    "id": 34,
    "start": "00:02:49,068",
    "end": "00:02:52,419",
    "text": "La ilaha illallah"
  },
  {
    "id": 35,
    "start": "00:02:52,419",
    "end": "00:02:54,015",
    "text": "Subhanallah"
  },
  {
    "id": 36,
    "start": "00:02:54,015",
    "end": "00:02:57,366",
    "text": "La ilaha illallah"
  },
  {
    "id": 37,
    "start": "00:02:57,366",
    "end": "00:02:58,883",
    "text": "Subhanallah"
  },
  {
    "id": 38,
    "start": "00:02:58,883",
    "end": "00:03:02,841",
    "text": "La ilaha illallah"
  },
  {
    "id": 39,
    "start": "00:03:03,191",
    "end": "00:03:08,537",
    "text": "Ya Allah"
  },
