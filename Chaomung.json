[
  {
    "id": 1,
    "start": "00:00:27,047",
    "end": "00:00:29,361",
    "text": "Gió thơm nhẹ bay qua hiên nhà,"
  },
  {
    "id": 2,
    "start": "00:00:29,361",
    "end": "00:00:33,750",
    "text": "Chim trên cành cất tiếng ngân xa."
  },
  {
    "id": 3,
    "start": "00:00:33,750",
    "end": "00:00:39,893",
    "text": "Trăng đêm nay như đang mong đợi,"
  },
  {
    "id": 4,
    "start": "00:00:39,893",
    "end": "00:00:43,722",
    "text": "Rót ánh vàng xuống khắp sân hoa."
  },
  {
    "id": 5,
    "start": "00:00:43,722",
    "end": "00:00:48,031",
    "text": "Và hôm nay, giữa bao ánh mắt,"
  },
  {
    "id": 6,
    "start": "00:00:48,031",
    "end": "00:00:52,340",
    "text": "Có một người tìm thấy con đường."
  },
  {
    "id": 7,
    "start": "00:00:52,340",
    "end": "00:00:56,569",
    "text": "Một trái tim vừa tìm về lại,"
  },
  {
    "id": 8,
    "start": "00:00:56,569",
    "end": "00:01:00,847",
    "text": "Với ánh sáng của đức tin thương."
  },
  {
    "id": 9,
    "start": "00:01:01,197",
    "end": "00:01:03,350",
    "text": "Alhamdulillah"
  },
  {
    "id": 10,
    "start": "00:01:03,350",
    "end": "00:01:05,346",
    "text": "Alhamdulillah"
  },
  {
    "id": 11,
    "start": "00:01:09,894",
    "end": "00:01:10,930",
    "text": "Chào mừng"
  },
  {
    "id": 12,
    "start": "00:01:10,930",
    "end": "00:01:13,882",
    "text": "Chào mừng người đã trở về."
  },
  {
    "id": 13,
    "start": "00:01:13,882",
    "end": "00:01:18,191",
    "text": "Chào mừng đến với một gia đình,"
  },
  {
    "id": 14,
    "start": "00:01:18,191",
    "end": "00:01:22,180",
    "text": "Nơi bầy tôi cùng quỳ trước Allah."
  },
  {
    "id": 15,
    "start": "00:01:22,180",
    "end": "00:01:23,855",
    "text": "Không còn xa lạ"
  },
  {
    "id": 16,
    "start": "00:01:23,855",
    "end": "00:01:26,649",
    "text": "Không còn một mình."
  },
  {
    "id": 17,
    "start": "00:01:26,649",
    "end": "00:01:28,563",
    "text": "Từ hôm nay"
  },
  {
    "id": 18,
    "start": "00:01:28,563",
    "end": "00:01:31,325",
    "text": "Chúng ta là anh em trong đức tin."
  },
  {
    "id": 19,
    "start": "00:01:31,676",
    "end": "00:01:35,903",
    "text": "La ilaha illallah"
  },
  {
    "id": 20,
    "start": "00:01:35,903",
    "end": "00:01:37,819",
    "text": "La ilaha illallah"
  },
  {
    "id": 21,
    "start": "00:01:37,819",
    "end": "00:01:42,466",
    "text": "Muhammadur Rasulullah"
  },
  {
    "id": 22,
    "start": "00:01:42,447",
    "end": "00:01:46,596",
    "text": "Có những hành trình đi rất xa,"
  },
  {
    "id": 23,
    "start": "00:01:46,596",
    "end": "00:01:50,983",
    "text": "Mới nhận ra nơi mình cần đến."
  },
  {
    "id": 24,
    "start": "00:01:50,983",
    "end": "00:01:54,733",
    "text": "Có những trái tim từng lạc bước,"
  },
  {
    "id": 25,
    "start": "00:01:54,733",
    "end": "00:01:59,043",
    "text": "Rồi tìm thấy bình minh trong đêm."
  },
  {
    "id": 26,
    "start": "00:01:59,043",
    "end": "00:02:01,834",
    "text": "Allah đã mở ra cánh cửa,"
  },
  {
    "id": 27,
    "start": "00:02:01,834",
    "end": "00:02:07,500",
    "text": "Khi trái tim biết hướng về Ngài."
  },
  {
    "id": 28,
    "start": "00:02:07,500",
    "end": "00:02:11,967",
    "text": "Một lời shahadah được cất lên,"
  },
  {
    "id": 29,
    "start": "00:02:11,967",
    "end": "00:02:14,650",
    "text": "Và một cuộc đời bắt đầu lại."
  },
  {
    "id": 30,
    "start": "00:02:21,144",
    "end": "00:02:22,979",
    "text": "Subhanallah"
  },
  {
    "id": 31,
    "start": "00:02:22,979",
    "end": "00:02:25,133",
    "text": "Alhamdulillah"
  },
  {
    "id": 32,
    "start": "00:02:25,133",
    "end": "00:02:27,097",
    "text": "Allahu akbar"
  },
  {
    "id": 33,
    "start": "00:02:27,447",
    "end": "00:02:31,835",
    "text": "Hôm nay người đến giữa nơi đây,"
  },
  {
    "id": 34,
    "start": "00:02:31,835",
    "end": "00:02:34,149",
    "text": "Như vì sao tìm về quanh nguyệt."
  },
  {
    "id": 35,
    "start": "00:02:34,149",
    "end": "00:02:39,653",
    "text": "Như cánh chim trở về cành xanh,"
  },
  {
    "id": 36,
    "start": "00:02:39,653",
    "end": "00:02:44,122",
    "text": "Sau những ngày bay xa mỏi mệt."
  },
  {
    "id": 37,
    "start": "00:02:44,122",
    "end": "00:02:48,431",
    "text": "Xin đừng nghĩ mình đang đơn độc,"
  },
  {
    "id": 38,
    "start": "00:02:48,431",
    "end": "00:02:52,818",
    "text": "Bởi bên cạnh vẫn có anh em."
  },
  {
    "id": 39,
    "start": "00:02:52,818",
    "end": "00:02:57,127",
    "text": "Cùng nhắc nhau khi lòng quên lãng,"
  },
  {
    "id": 40,
    "start": "00:02:57,127",
    "end": "00:03:00,049",
    "text": "Cùng nâng nhau qua những đêm đen."
  },
  {
    "id": 41,
    "start": "00:03:01,995",
    "end": "00:03:03,032",
    "text": "Ya Allah"
  },
  {
    "id": 42,
    "start": "00:03:03,830",
    "end": "00:03:10,632",
    "text": "Alhamdulillah"
  },
  {
    "id": 43,
    "start": "00:03:10,611",
    "end": "00:03:11,010",
    "text": "Nào"
  },
  {
    "id": 44,
    "start": "00:03:11,010",
    "end": "00:03:12,206",
    "text": "Hãy cùng bước."
  },
  {
    "id": 45,
    "start": "00:03:12,206",
    "end": "00:03:14,361",
    "text": "Con đường này có lúc dài xa."
  },
  {
    "id": 46,
    "start": "00:03:14,361",
    "end": "00:03:15,399",
    "text": "Có những ngày"
  },
  {
    "id": 47,
    "start": "00:03:15,399",
    "end": "00:03:18,590",
    "text": "Ta sẽ yếu lòng."
  },
  {
    "id": 48,
    "start": "00:03:18,590",
    "end": "00:03:19,706",
    "text": "Nhưng hãy nhớ"
  },
  {
    "id": 49,
    "start": "00:03:19,706",
    "end": "00:03:22,899",
    "text": "Allah chưa từng rời xa"
  },
  {
    "id": 50,
    "start": "00:03:22,899",
    "end": "00:03:23,855",
    "text": "Một trái tim"
  },
  {
    "id": 51,
    "start": "00:03:23,855",
    "end": "00:03:27,256",
    "text": "Thật lòng tìm về với Ngài."
  },
  {
    "id": 52,
    "start": "00:03:31,675",
    "end": "00:03:37,181",
    "text": "Chào mừng"
  },
  {
    "id": 53,
    "start": "00:03:37,181",
    "end": "00:03:39,254",
    "text": "Chào mừng người đã trở về."
  },
  {
    "id": 54,
    "start": "00:03:39,254",
    "end": "00:03:43,004",
    "text": "Hôm nay không chỉ là một ngày mới,"
  },
  {
    "id": 55,
    "start": "00:03:43,004",
    "end": "00:03:47,552",
    "text": "Mà là một bình minh của trái tim."
  },
  {
    "id": 56,
    "start": "00:03:47,552",
    "end": "00:03:48,909",
    "text": "Từ hôm nay"
  },
  {
    "id": 57,
    "start": "00:03:48,909",
    "end": "00:03:51,302",
    "text": "Mỗi lời cầu nguyện,"
  },
  {
    "id": 58,
    "start": "00:03:51,302",
    "end": "00:03:53,138",
    "text": "Mỗi bước chân,"
  },
  {
    "id": 59,
    "start": "00:03:53,138",
    "end": "00:03:56,378",
    "text": "Đều hướng về Allah."
  },
  {
    "id": 60,
    "start": "00:03:56,729",
    "end": "00:03:58,563",
    "text": "La ilaha illallah"
  },
  {
    "id": 61,
    "start": "00:03:58,563",
    "end": "00:04:01,037",
    "text": "Alhamdulillah"
  },
  {
    "id": 62,
    "start": "00:04:01,037",
    "end": "00:04:02,633",
    "text": "Subhanallah"
  },
  {
    "id": 63,
    "start": "00:04:02,633",
    "end": "00:04:09,162",
    "text": "Allahu akbar"
  },
  {
    "id": 64,
    "start": "00:04:15,239",
    "end": "00:04:17,632",
    "text": "Chào mừng trở về"
  },
  {
    "id": 65,
    "start": "00:04:17,632",
    "end": "00:04:19,786",
    "text": "Với ánh sáng"
  },
  {
    "id": 66,
    "start": "00:04:19,786",
    "end": "00:04:23,218",
    "text": "Với Islam"
  },
  {
    "id": 67,
    "start": "00:04:23,218",
    "end": "00:04:24,733",
    "text": "Alhamdulillah"
  }
]