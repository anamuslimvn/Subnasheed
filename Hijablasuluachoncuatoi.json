[
  {
    "id": 1,
    "start": "00:00:23,936",
    "end": "00:00:29,282",
    "text": "Họ bảo tôi: “Hãy tháo chiếc khăn ấy,"
  },
  {
    "id": 2,
    "start": "00:00:29,282",
    "end": "00:00:33,191",
    "text": "Đời sẽ đẹp hơn nếu em tự do…”"
  },
  {
    "id": 3,
    "start": "00:00:33,191",
    "end": "00:00:40,771",
    "text": "Họ đem lời ngọt ngào che đi sự thật,"
  },
  {
    "id": 4,
    "start": "00:00:40,771",
    "end": "00:00:46,435",
    "text": "Đem vẻ ngoài đổi lấy một niềm tin."
  },
  {
    "id": 5,
    "start": "00:00:46,435",
    "end": "00:00:52,021",
    "text": "Có những ngày lòng tôi từng dao động,"
  },
  {
    "id": 6,
    "start": "00:00:52,021",
    "end": "00:00:57,527",
    "text": "Từng tự hỏi: “Mình có đang quá khác người?”"
  },
  {
    "id": 7,
    "start": "00:00:57,527",
    "end": "00:01:02,792",
    "text": "Rồi trái tim khe khẽ nhắc tôi rằng:"
  },
  {
    "id": 8,
    "start": "00:01:02,792",
    "end": "00:01:07,180",
    "text": "“Được thế gian yêu… đâu bằng được Allah hài lòng.”"
  },
  {
    "id": 9,
    "start": "00:01:09,495",
    "end": "00:01:14,043",
    "text": "Không, tôi sẽ không tháo Hijab,"
  },
  {
    "id": 10,
    "start": "00:01:14,043",
    "end": "00:01:19,468",
    "text": "Dẫu cả thế gian quay lưng với tôi."
  },
  {
    "id": 11,
    "start": "00:01:19,468",
    "end": "00:01:25,531",
    "text": "Bởi chiếc khăn này không che giấu tôi,"
  },
  {
    "id": 12,
    "start": "00:01:25,531",
    "end": "00:01:43,918",
    "text": "Mà nhắc tôi mình thuộc về ai."
  },
  {
    "id": 13,
    "start": "00:01:54,096",
    "end": "00:01:58,644",
    "text": "Tôi không mặc Hijab để hơn người,"
  },
  {
    "id": 14,
    "start": "00:01:58,644",
    "end": "00:02:02,313",
    "text": "Không để được ngợi khen hay nhìn thấy."
  },
  {
    "id": 15,
    "start": "00:02:02,313",
    "end": "00:02:09,813",
    "text": "Tôi mang Hijab, chẳng cầu ai hiểu,"
  },
  {
    "id": 16,
    "start": "00:02:09,813",
    "end": "00:02:13,802",
    "text": "Vì trái tim tôi muốn đáp lời Ngài."
  },
  {
    "id": 17,
    "start": "00:02:16,754",
    "end": "00:02:22,340",
    "text": "A-i-sha là ánh sáng tôi noi theo,"
  },
  {
    "id": 18,
    "start": "00:02:22,340",
    "end": "00:02:27,846",
    "text": "Safiyyah là tấm gương của đức tin."
  },
  {
    "id": 19,
    "start": "00:02:27,846",
    "end": "00:02:30,558",
    "text": "Họ đã sống giữa cuộc đời rộng lớn,"
  },
  {
    "id": 20,
    "start": "00:02:30,558",
    "end": "00:02:37,899",
    "text": "Nhưng trái tim chẳng rời khỏi Allah."
  },
  {
    "id": 21,
    "start": "00:02:37,899",
    "end": "00:02:43,484",
    "text": "Vì điều đáng sợ chẳng phải là khác biệt,"
  },
  {
    "id": 22,
    "start": "00:02:43,484",
    "end": "00:02:48,830",
    "text": "Mà là một ngày quên mất Đấng mình yêu."
  },
  {
    "id": 23,
    "start": "00:02:48,830",
    "end": "00:02:54,495",
    "text": "Thà bước một mình trên con đường ngay thẳng,"
  },
  {
    "id": 24,
    "start": "00:02:54,495",
    "end": "00:03:01,116",
    "text": "Còn hơn đông người… mà xa cách Allah."
  },
  {
    "id": 25,
    "start": "00:03:01,116",
    "end": "00:03:03,909",
    "text": "Ya Rabb… xin giữ vững trái tim này,"
  },
  {
    "id": 26,
    "start": "00:03:03,909",
    "end": "00:03:11,169",
    "text": "Khi lời thế gian trở nên quá ngọt ngào."
  },
  {
    "id": 27,
    "start": "00:03:11,169",
    "end": "00:03:17,153",
    "text": "Xin đừng để bề tôi đánh đổi đức tin"
  },
  {
    "id": 28,
    "start": "00:03:17,153",
    "end": "00:03:22,100",
    "text": "Chỉ để nhận một ánh nhìn hài lòng."
  },
  {
    "id": 29,
    "start": "00:03:22,100",
    "end": "00:03:24,495",
    "text": "Tôi đã chọn…"
  },
  {
    "id": 30,
    "start": "00:03:24,495",
    "end": "00:03:27,526",
    "text": "Và sẽ mãi chọn…"
  },
  {
    "id": 31,
    "start": "00:03:27,526",
    "end": "00:03:39,495",
    "text": "Sự hài lòng của Allah."
  },
  {
    "id": 32,
    "start": "00:03:41,568",
    "end": "00:03:57,366",
    "text": "La ilaha illallah…"
  }
]