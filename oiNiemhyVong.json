  },
  {
    "id": 4,
    "start": "00:00:14,680",
    "end": "00:00:18,589",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 5,
    "start": "00:00:18,589",
    "end": "00:00:22,899",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 6,
    "start": "00:00:22,899",
    "end": "00:00:26,777",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 7,
    "start": "00:00:27,128",
    "end": "00:00:31,356",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 8,
    "start": "00:00:31,356",
    "end": "00:00:49,069",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 9,
    "start": "00:00:49,069",
    "end": "00:00:52,819",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 10,
    "start": "00:00:52,819",
    "end": "00:00:57,048",
    "text": "Đôi tay bề tôi vươn về ánh sáng,"
  },
  {
    "id": 11,
    "start": "00:00:57,048",
    "end": "00:01:01,277",
    "text": "Giữa màn đêm không một vì sao."
  },
  {
    "id": 12,
    "start": "00:01:01,277",
    "end": "00:01:04,149",
    "text": "Chiếc bình đã cạn từ rất lâu,"
  },
  {
    "id": 13,
    "start": "00:01:04,149",
    "end": "00:01:10,052",
    "text": "Mà cơn khát vẫn chưa nguôi."
  },
  {
    "id": 14,
    "start": "00:01:10,052",
    "end": "00:01:14,281",
    "text": "Con đường in đầy dấu chân,"
  },
  {
    "id": 15,
    "start": "00:01:14,281",
    "end": "00:01:18,430",
    "text": "Nhưng chẳng thấy cuối lối là đâu."
  },
  {
    "id": 16,
    "start": "00:01:18,430",
    "end": "00:01:22,819",
    "text": "Bề tôi cất tiếng giữa biển rộng,"
  },
  {
    "id": 17,
    "start": "00:01:22,819",
    "end": "00:01:29,043",
    "text": "Chỉ mình Ngài nghe lời thì thầm."
  },
  {
    "id": 18,
    "start": "00:01:35,665",
    "end": "00:01:39,972",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 19,
    "start": "00:01:39,972",
    "end": "00:01:44,281",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 20,
    "start": "00:01:44,281",
    "end": "00:01:48,590",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 21,
    "start": "00:01:48,590",
    "end": "00:01:52,899",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 22,
    "start": "00:01:52,899",
    "end": "00:01:56,489",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 23,
    "start": "00:01:56,489",
    "end": "00:02:01,277",
    "text": "Xin rót ánh sáng vào tim bề tôi."
  },
  {
    "id": 24,
    "start": "00:02:01,277",
    "end": "00:02:04,228",
    "text": "Đừng để ngọn đèn này lụi tắt,"
  },
  {
    "id": 25,
    "start": "00:02:04,228",
    "end": "00:02:07,388",
    "text": "Giữa cơn gió của cuộc đời."
  },
  {
    "id": 26,
    "start": "00:02:09,973",
    "end": "00:02:14,361",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 27,
    "start": "00:02:14,361",
    "end": "00:02:18,510",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 28,
    "start": "00:02:18,510",
    "end": "00:02:21,941",
    "text": "Xin nắm lấy con thuyền nhỏ."
  },
  {
    "id": 29,
    "start": "00:02:21,941",
    "end": "00:02:23,855",
    "text": "Trước khi những con sóng,"
  },
  {
    "id": 30,
    "start": "00:02:23,855",
    "end": "00:02:27,048",
    "text": "Nuốt mất bờ quay về."
  },
  {
    "id": 31,
    "start": "00:02:27,048",
    "end": "00:02:31,436",
    "text": "Bình minh đứng sau tầng mây,"
  },
  {
    "id": 32,
    "start": "00:02:31,436",
    "end": "00:02:34,229",
    "text": "Mà lòng bề tôi vẫn là đêm."
  },
  {
    "id": 33,
    "start": "00:02:34,229",
    "end": "00:02:37,899",
    "text": "Bầy tôi tìm nguồn nước,"
  },
  {
    "id": 34,
    "start": "00:02:37,899",
    "end": "00:02:40,052",
    "text": "Giữa một dòng sông khô."
  },
  {
    "id": 35,
    "start": "00:02:40,052",
    "end": "00:02:43,403",
    "text": "Chiếc thuyền chở đầy lỗi lầm,"
  },
  {
    "id": 36,
    "start": "00:02:43,403",
    "end": "00:02:48,590",
    "text": "Lênh đênh không thấy bến."
  },
  {
    "id": 37,
    "start": "00:02:48,590",
    "end": "00:02:52,899",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 38,
    "start": "00:02:52,899",
    "end": "00:02:57,127",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 39,
    "start": "00:02:57,127",
    "end": "00:03:01,436",
    "text": "Chỉ lòng thương xót của Ngài,"
  },
  {
    "id": 40,
    "start": "00:03:01,436",
    "end": "00:03:07,979",
    "text": "Là ngọn hải đăng giữa biển đêm."
  },
  {
    "id": 41,
    "start": "00:03:23,377",
    "end": "00:03:27,366",
    "text": "Nếu Ngài không mở một cánh cửa,"
  },
  {
    "id": 42,
    "start": "00:03:27,366",
    "end": "00:03:31,995",
    "text": "Mọi lối đi đều thành ngõ cụt."
  },
  {
    "id": 43,
    "start": "00:03:31,995",
    "end": "00:03:35,664",
    "text": "Nếu Ngài không thắp một ngọn đèn,"
  },
  {
    "id": 44,
    "start": "00:03:35,664",
    "end": "00:03:42,287",
    "text": "Mọi bình minh cũng hóa màn đêm."
  },
  {
    "id": 45,
    "start": "00:03:42,287",
    "end": "00:03:45,956",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 46,
    "start": "00:03:45,956",
    "end": "00:03:50,824",
    "text": "Xin để bề tôi ở dưới ánh sáng."
  },
  {
    "id": 47,
    "start": "00:03:50,824",
    "end": "00:03:54,574",
    "text": "Dẫu sa mạc dài đến mấy,"
  },
  {
    "id": 48,
    "start": "00:03:54,574",
    "end": "00:03:59,441",
    "text": "Bề tôi vẫn bước về Ngài."
  },
  {
    "id": 49,
    "start": "00:03:59,441",
    "end": "00:04:02,153",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 50,
    "start": "00:04:02,153",
    "end": "00:04:08,138",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 51,
    "start": "00:04:08,138",
    "end": "00:04:12,206",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 52,
    "start": "00:04:12,206",
    "end": "00:04:16,596",
    "text": "Xin đừng buông tay bề tôi."
  },
  {
    "id": 53,
    "start": "00:04:16,596",
    "end": "00:04:20,745",
    "text": "Cho đến ngày..."
  },
  {
    "id": 54,
    "start": "00:04:20,745",
    "end": "00:04:23,776",
    "text": "Bề tôi gặp Ngài trong bình an."
  },
  {
    "id": 55,
    "start": "00:04:23,776",
    "end": "00:04:38,617",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 56,
    "start": "00:04:38,617",
    "end": "00:04:46,675",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 57,
    "start": "00:04:46,675",
    "end": "00:04:51,064",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 58,
    "start": "00:04:51,064",
    "end": "00:04:56,488",
    "text": "Ôi niềm hy vọng..."
  },
  {
    "id": 59,
    "start": "00:04:56,488",
    "end": "00:05:00,718",
    "text": "Ôi niềm hy vọng..."
