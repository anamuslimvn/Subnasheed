[
  {
    "id": 1,
    "start": "00:00:01,036",
    "end": "00:00:06,782",
    "text": "Bầy tôi đã chờ đợi, bầy tôi đã tổn thương,"
  },
  {
    "id": 2,
    "start": "00:00:06,782",
    "end": "00:00:13,803",
    "text": "Bầy tôi đã ngã nhiều lần, chẳng còn chỗ để bám."
  },
  {
    "id": 3,
    "start": "00:00:13,803",
    "end": "00:00:19,149",
    "text": "Tim này đã rạn nứt, mắt này đã khô cạn,"
  },
  {
    "id": 4,
    "start": "00:00:19,149",
    "end": "00:00:25,181",
    "text": "Ya Rabb… bầy tôi lại gọi Ngài."
  },
  {
    "id": 5,
    "start": "00:00:25,532",
    "end": "00:00:28,803",
    "text": "Chẳng còn sức gồng thêm,"
  },
  {
    "id": 6,
    "start": "00:00:28,803",
    "end": "00:00:31,835",
    "text": "Nỗi đau này quá lớn."
  },
  {
    "id": 7,
    "start": "00:00:31,835",
    "end": "00:00:34,069",
    "text": "Chỉ muốn tan biến đi."
  },
  {
    "id": 8,
    "start": "00:00:36,941",
    "end": "00:00:40,771",
    "text": "Chẳng còn sức gồng thêm,"
  },
  {
    "id": 9,
    "start": "00:00:40,771",
    "end": "00:00:43,802",
    "text": "Nỗi đau này quá lớn."
  },
  {
    "id": 10,
    "start": "00:00:43,802",
    "end": "00:00:46,036",
    "text": "Chỉ muốn tan biến đi."
  },
  {
    "id": 11,
    "start": "00:00:49,866",
    "end": "00:00:54,734",
    "text": "Astaghfirullah…"
  },
  {
    "id": 12,
    "start": "00:00:54,734",
    "end": "00:00:56,378",
    "text": "Xin Allah tha thứ cho bầy tôi."
  },
  {
    "id": 13,
    "start": "00:00:56,728",
    "end": "00:01:04,787",
    "text": "Bầy tôi tan vỡ, vết thương còn chưa lành,"
  },
  {
    "id": 14,
    "start": "00:01:04,787",
    "end": "00:01:08,058",
    "text": "Lạc giữa nhân gian… chẳng biết lối quay về."
  },
  {
    "id": 15,
    "start": "00:01:08,058",
    "end": "00:01:10,850",
    "text": "Bao lần tin tưởng, bao lần rồi thất vọng,"
  },
  {
    "id": 16,
    "start": "00:01:10,850",
    "end": "00:01:13,722",
    "text": "Hơi thở mong manh… như chìm giữa vực sâu."
  },
  {
    "id": 17,
    "start": "00:01:13,722",
    "end": "00:01:16,995",
    "text": "Bầy tôi muốn khóc… mà lệ chẳng còn rơi,"
  },
  {
    "id": 18,
    "start": "00:01:16,995",
    "end": "00:01:19,947",
    "text": "Muốn nói một lời… nhưng môi chẳng thành tiếng."
  },
  {
    "id": 19,
    "start": "00:01:19,947",
    "end": "00:01:22,819",
    "text": "Ngày nối ngày qua, nỗi đau càng sâu thêm,"
  },
  {
    "id": 20,
    "start": "00:01:22,819",
    "end": "00:01:26,936",
    "text": "Bầy tôi dần kiệt sức… giữa một đời chơi vơi."
  },
  {
    "id": 21,
    "start": "00:01:27,287",
    "end": "00:01:28,722",
    "text": "Chẳng còn sức gồng thêm,"
  },
  {
    "id": 22,
    "start": "00:01:28,722",
    "end": "00:01:30,319",
    "text": "Nỗi đau này quá lớn."
  },
  {
    "id": 23,
    "start": "00:01:30,319",
    "end": "00:01:31,754",
    "text": "Nỗi đau này quá lớn."
  },
  {
    "id": 24,
    "start": "00:01:31,754",
    "end": "00:01:33,271",
    "text": "Chỉ muốn tan biến đi."
  },
  {
    "id": 25,
    "start": "00:01:37,500",
    "end": "00:01:40,611",
    "text": "Chẳng còn sức gồng thêm,"
  },
  {
    "id": 26,
    "start": "00:01:40,611",
    "end": "00:01:42,367",
    "text": "Nỗi đau này quá lớn."
  },
  {
    "id": 27,
    "start": "00:01:42,367",
    "end": "00:01:43,802",
    "text": "Nỗi đau này quá lớn."
  },
  {
    "id": 28,
    "start": "00:01:43,802",
    "end": "00:01:45,319",
    "text": "Chỉ muốn tan biến đi."
  },
  {
    "id": 29,
    "start": "00:01:47,951",
    "end": "00:01:54,733",
    "text": "Astaghfirullah…"
  },
  {
    "id": 30,
    "start": "00:01:54,733",
    "end": "00:02:02,762",
    "text": "Xin Allah tha thứ cho bầy tôi."
  },
  {
    "id": 31,
    "start": "00:02:03,111",
    "end": "00:02:04,947",
    "text": "Bầy tôi thôi không chạy nữa,"
  },
  {
    "id": 32,
    "start": "00:02:04,947",
    "end": "00:02:09,096",
    "text": "Xin Ngài mở cửa, đừng để bầy tôi ngoài này."
  },
  {
    "id": 33,
    "start": "00:02:09,096",
    "end": "00:02:11,010",
    "text": "Bầy tôi xin quy phục,"
  },
  {
    "id": 34,
    "start": "00:02:11,010",
    "end": "00:02:15,159",
    "text": "Đặt tim này xuống trước Ngài."
  },
  {
    "id": 35,
    "start": "00:02:15,159",
    "end": "00:02:16,754",
    "text": "Bầy tôi nhớ những ngày cũ,"
  },
  {
    "id": 36,
    "start": "00:02:16,754",
    "end": "00:02:20,186",
    "text": "Và giờ đây… bầy tôi chỉ muốn về bên Ngài."
  },
  {
    "id": 37,
    "start": "00:02:20,186",
    "end": "00:02:23,456",
    "text": "Bầy tôi chỉ còn một điều,"
  },
  {
    "id": 38,
    "start": "00:02:23,456",
    "end": "00:02:25,931",
    "text": "Là thật lòng gọi tên Ngài."
  },
  {
    "id": 39,
    "start": "00:02:25,931",
    "end": "00:02:30,717",
    "text": "Và bầy tôi biết…"
  },
  {
    "id": 40,
    "start": "00:02:30,717",
    "end": "00:02:32,602",
    "text": "Ngài vẫn ở đây, không rời bầy tôi."
  },
  {
    "id": 41,
    "start": "00:02:32,951",
    "end": "00:02:36,861",
    "text": "Astaghfirullah…"
  },
  {
    "id": 42,
    "start": "00:02:36,861",
    "end": "00:02:38,776",
    "text": "Xin Allah tha thứ cho bầy tôi."
  },
  {
    "id": 43,
    "start": "00:02:38,776",
    "end": "00:03:07,659",
    "text": "Astaghfirullah…"
  },
  {
    "id": 44,
    "start": "00:03:07,659",
    "end": "00:03:09,933",
    "text": "Forgive me, Allah…"
  }
]