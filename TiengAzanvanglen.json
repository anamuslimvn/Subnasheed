[
  {
    "id": 1,
    "start": "00:00:19,149",
    "end": "00:00:22,420",
    "text": "Bề tôi từng lạc lối."
  },
  {
    "id": 2,
    "start": "00:00:23,696",
    "end": "00:00:27,367",
    "text": "Trái tim bề tôi đầy ưu phiền."
  },
  {
    "id": 3,
    "start": "00:00:27,367",
    "end": "00:00:32,234",
    "text": "Bề tôi quên đi nhiều ân huệ của Allah."
  },
  {
    "id": 4,
    "start": "00:00:34,149",
    "end": "00:00:37,261",
    "text": "Rồi tiếng Adhan vang lên."
  },
  {
    "id": 5,
    "start": "00:00:38,697",
    "end": "00:00:41,968",
    "text": "Bề tôi trở lại với Salah."
  },
  {
    "id": 6,
    "start": "00:00:43,643",
    "end": "00:00:48,590",
    "text": "Trong sujud, nước mắt bề tôi lặng lẽ"
  },
  {
    "id": 7,
    "start": "00:00:49,069",
    "end": "00:00:49,387",
    "text": "rơi."
  },
  {
    "id": 8,
    "start": "00:00:50,984",
    "end": "00:00:56,728",
    "text": "Allah đã ban bình an cho bề tôi."
  },
  {
    "id": 9,
    "start": "00:00:58,164",
    "end": "00:01:03,988",
    "text": "Từ đó, chúng ta bước theo Qur'an."
  },
  {
    "id": 10,
    "start": "00:01:05,584",
    "end": "00:01:10,052",
    "text": "Chúng ta hy vọng được vào Jannah."
  },
  {
    "id": 11,
    "start": "00:01:10,771",
    "end": "00:01:18,510",
    "text": "Và chúng ta mãi nói: La ilaha illallah."
  },
  {
    "id": 12,
    "start": "00:01:25,052",
    "end": "00:01:28,165",
    "text": "Bề tôi từng lạc lối."
