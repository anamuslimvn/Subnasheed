[
  {
    "id": 1,
    "start": "00:00:26,649",
    "end": "00:00:29,760",
    "text": "Allah biết những tháng ngày đau khổ,"
  },
  {
    "id": 2,
    "start": "00:00:29,760",
    "end": "00:00:32,951",
    "text": "Biết lòng bầy tôi mỏi mệt bao lần."
  },
  {
    "id": 3,
    "start": "00:00:32,951",
    "end": "00:00:36,143",
    "text": "Biết những đêm dài, nước mắt âm thầm,"
  },
  {
    "id": 4,
    "start": "00:00:36,143",
    "end": "00:00:39,414",
    "text": "Biết cả những điều chưa từng thổ lộ."
  },
  {
    "id": 5,
    "start": "00:00:42,527",
    "end": "00:00:45,718",
    "text": "Khi đường trước mắt phủ đầy gian khó,"
  },
  {
    "id": 6,
    "start": "00:00:45,718",
    "end": "00:00:48,112",
    "text": "Khi lòng bầy tôi chẳng biết về đâu,"
  },
  {
    "id": 7,
    "start": "00:00:48,112",
    "end": "00:00:52,180",
    "text": "Vẫn còn Allah... để hy vọng,"
  },
  {
    "id": 8,
    "start": "00:00:52,180",
    "end": "00:00:55,451",
    "text": "Vẫn còn Allah... luôn luôn thấu hiểu."
  },
  {
    "id": 9,
    "start": "00:00:58,564",
    "end": "00:01:01,835",
    "text": "Bầy tôi ngẩng tay giữa trời đêm,"
  },
  {
    "id": 10,
    "start": "00:01:01,835",
    "end": "00:01:04,947",
    "text": "Chẳng có gì ngoài một niềm tin."
  },
  {
    "id": 11,
    "start": "00:01:04,947",
    "end": "00:01:07,420",
    "text": "Dẫu chưa thấy lối ngày mai,"
  },
  {
    "id": 12,
    "start": "00:01:07,420",
    "end": "00:01:09,570",
    "text": "Vẫn tin ân phước sẽ đến."
  },
  {
    "id": 13,
    "start": "00:01:11,409",
    "end": "00:01:14,600",
    "text": "Allah biết... Allah biết..."
  },
  {
    "id": 14,
    "start": "00:01:14,600",
    "end": "00:01:17,073",
    "text": "Những khổ đau bầy tôi mang."
  },
  {
    "id": 15,
    "start": "00:01:17,073",
    "end": "00:01:21,144",
    "text": "Allah biết... Allah biết..."
  },
  {
    "id": 16,
    "start": "00:01:21,144",
    "end": "00:01:22,686",
    "text": "Những tháng ngày đầy gian nan."
  },
  {
    "id": 17,
    "start": "00:01:24,176",
    "end": "00:01:27,367",
    "text": "Bầy tôi cầu xin nơi Ngài,"
  },
  {
    "id": 18,
    "start": "00:01:27,367",
    "end": "00:01:30,956",
    "text": "Niềm hy vọng chẳng bao giờ mất."
  },
  {
    "id": 19,
    "start": "00:01:30,956",
    "end": "00:01:33,829",
    "text": "Bàn tay ngẩng lên cầu Ngài,"
  },
  {
    "id": 20,
    "start": "00:01:33,829",
    "end": "00:01:37,069",
    "text": "Không trở về tay không."
  },
  {
    "id": 21,
    "start": "00:01:50,027",
    "end": "00:01:52,899",
    "text": "Biết bao ân phước Ngài đã ban xuống,"
  },
  {
    "id": 22,
    "start": "00:01:52,899",
    "end": "00:01:56,170",
    "text": "Trước cả khi bầy tôi biết cầu xin."
  },
  {
    "id": 23,
    "start": "00:01:56,170",
    "end": "00:01:59,281",
    "text": "Biết bao lần Ngài mở lối bình yên,"
  },
  {
    "id": 24,
    "start": "00:01:59,281",
    "end": "00:02:02,632",
    "text": "Khi bầy tôi tưởng chẳng còn hy vọng."
  },
  {
    "id": 25,
    "start": "00:02:05,665",
    "end": "00:02:08,855",
    "text": "Ngài cho nhiều hơn điều lòng mong ước,"
  },
  {
    "id": 26,
    "start": "00:02:08,855",
    "end": "00:02:12,127",
    "text": "Ngài làm giàu bằng ân huệ vô biên."
  },
  {
    "id": 27,
    "start": "00:02:12,127",
    "end": "00:02:15,399",
    "text": "Một lòng thành kính, một chút niềm tin,"
  },
  {
    "id": 28,
    "start": "00:02:15,399",
    "end": "00:02:17,282",
    "text": "Đã đủ để bầy tôi bước tiếp."
  },
  {
    "id": 29,
    "start": "00:02:17,633",
    "end": "00:02:21,701",
    "text": "Vậy nên dù đời còn nhiều giông tố,"
  },
  {
    "id": 30,
    "start": "00:02:21,701",
    "end": "00:02:24,894",
    "text": "Đừng để ưu phiền lấy mất niềm tin."
  },
  {
    "id": 31,
    "start": "00:02:24,894",
    "end": "00:02:28,164",
    "text": "Bởi Allah biết điều lòng cầu xin,"
  },
  {
    "id": 32,
    "start": "00:02:28,164",
    "end": "00:02:30,492",
    "text": "Và Ngài biết điều gì tốt nhất."
  },
  {
    "id": 33,
    "start": "00:02:33,032",
    "end": "00:02:36,223",
    "text": "Allah biết... Allah biết..."
  },
  {
    "id": 34,
    "start": "00:02:36,223",
    "end": "00:02:39,414",
    "text": "Những khổ đau bầy tôi mang."
  },
  {
    "id": 35,
    "start": "00:02:39,414",
    "end": "00:02:42,605",
    "text": "Allah biết... Allah biết..."
  },
  {
    "id": 36,
    "start": "00:02:42,605",
    "end": "00:02:44,229",
    "text": "Những tháng ngày đầy gian nan."
  },
  {
    "id": 37,
    "start": "00:02:45,717",
    "end": "00:02:48,270",
    "text": "Bầy tôi cầu xin nơi Ngài,"
  },
  {
    "id": 38,
    "start": "00:02:48,270",
    "end": "00:02:52,580",
    "text": "Niềm hy vọng chẳng bao giờ mất."
  },
  {
    "id": 39,
    "start": "00:02:52,580",
    "end": "00:02:55,451",
    "text": "Bàn tay ngẩng lên cầu Ngài,"
  },
  {
    "id": 40,
    "start": "00:02:55,451",
    "end": "00:02:58,453",
    "text": "Không trở về tay không."
  },
  {
    "id": 41,
    "start": "00:02:58,802",
    "end": "00:03:01,995",
    "text": "Có thể hôm nay... chưa thấy câu trả lời,"
  },
  {
    "id": 42,
    "start": "00:03:01,995",
    "end": "00:03:04,947",
    "text": "Có thể con đường... vẫn còn xa xôi."
  },
  {
    "id": 43,
    "start": "00:03:04,947",
    "end": "00:03:08,138",
    "text": "Nhưng ân phước Ngài... chưa từng vơi,"
  },
  {
    "id": 44,
    "start": "00:03:08,138",
    "end": "00:03:20,971",
    "text": "Chỉ là đến lúc... Allah muốn thôi."
  },
  {
    "id": 45,
    "start": "00:03:24,254",
    "end": "00:03:27,447",
    "text": "Allah biết... Allah biết..."
  },
  {
    "id": 46,
    "start": "00:03:27,447",
    "end": "00:03:30,638",
    "text": "Những khổ đau bầy tôi mang."
  },
  {
    "id": 47,
    "start": "00:03:30,638",
    "end": "00:03:33,830",
    "text": "Allah biết... Allah biết..."
  },
  {
    "id": 48,
    "start": "00:03:33,830",
    "end": "00:03:35,850",
    "text": "Những tháng ngày đầy gian nan."
  },
  {
    "id": 49,
    "start": "00:03:37,340",
    "end": "00:03:40,133",
    "text": "Bầy tôi tin tưởng nơi Ngài,"
  },
  {
    "id": 50,
    "start": "00:03:40,133",
    "end": "00:03:43,723",
    "text": "Dẫu cuộc đời còn bao thử thách."
  },
  {
    "id": 51,
    "start": "00:03:43,723",
    "end": "00:03:46,596",
    "text": "Bàn tay ngẩng lên cầu Ngài,"
  },
  {
    "id": 52,
    "start": "00:03:46,596",
    "end": "00:03:50,598",
    "text": "Không trở về tay không."
  },
  {
    "id": 53,
    "start": "00:03:53,138",
    "end": "00:03:56,330",
    "text": "Allah biết..."
  },
  {
    "id": 54,
    "start": "00:03:56,330",
    "end": "00:03:57,846",
    "text": "Allah biết..."
  },
  {
    "id": 55,
    "start": "00:04:02,552",
    "end": "00:04:06,223",
    "text": "Bầy tôi tin nơi Ngài..."
  },
  {
    "id": 56,
    "start": "00:04:06,223",
    "end": "00:04:09,414",
    "text": "Alhamdulillah..."
  }
]