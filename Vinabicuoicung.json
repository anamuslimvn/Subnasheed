[
  {
    "id": 1,
    "start": "00:00:28,963",
    "end": "00:00:32,633",
    "text": "Khi nhân gian chìm trong đêm tối,"
  },
  {
    "id": 2,
    "start": "00:00:32,633",
    "end": "00:00:36,302",
    "text": "Lòng người lạc lối giữa muôn phương."
  },
  {
    "id": 3,
    "start": "00:00:36,302",
    "end": "00:00:39,972",
    "text": "Allah đã gửi đến một ánh sáng,"
  },
  {
    "id": 4,
    "start": "00:00:39,972",
    "end": "00:00:43,963",
    "text": "Dẫn đường về chân lý yêu thương."
  },
  {
    "id": 5,
    "start": "00:00:43,963",
    "end": "00:00:47,713",
    "text": "Từ Makkah vùng đất thiêng liêng,"
  },
  {
    "id": 6,
    "start": "00:00:47,713",
    "end": "00:00:51,463",
    "text": "Lời chân thật vang xa khắp chốn."
  },
  {
    "id": 7,
    "start": "00:00:51,463",
    "end": "00:00:54,893",
    "text": "Kêu gọi người quay về thờ phượng,"
  },
  {
    "id": 8,
    "start": "00:00:54,893",
    "end": "00:00:58,771",
    "text": "Một mình Allah Đấng Tối Cao."
  },
  {
    "id": 9,
    "start": "00:01:09,121",
    "end": "00:01:02,633",
    "text": "Hỡi anh em Muslim khắp nơi,"
  },
  {
    "id": 10,
    "start": "00:01:02,633",
    "end": "00:01:06,382",
    "text": "Hãy lắng nghe lời Người truyền dạy."
  },
  {
    "id": 11,
    "start": "00:01:06,382",
    "end": "00:01:09,733",
    "text": "Muhammad, vị Nabi cao quý,"
  },
  {
    "id": 12,
    "start": "00:01:09,733",
    "end": "00:01:13,722",
    "text": "Tấm gương sáng cho cả cuộc đời."
  },
  {
    "id": 13,
    "start": "00:01:13,722",
    "end": "00:01:17,552",
    "text": "Đức hạnh Người như trăng đêm sáng,"
  },
  {
    "id": 14,
    "start": "00:01:17,552",
    "end": "00:01:21,222",
    "text": "Mang yêu thương và lòng khoan dung."
  },
  {
    "id": 15,
    "start": "00:01:21,222",
    "end": "00:01:24,972",
    "text": "Người dẫn lối Ummah đi tới,"
  },
  {
    "id": 16,
    "start": "00:01:24,972",
    "end": "00:01:29,968",
    "text": "Con đường về Jannah bình yên."
  },
  {
    "id": 17,
    "start": "00:01:30,319",
    "end": "00:01:34,069",
    "text": "Người chịu đựng biết bao gian khó,"
  },
  {
    "id": 18,
    "start": "00:01:34,069",
    "end": "00:01:37,978",
    "text": "Để truyền đi mặc khải từ trời."
  },
  {
    "id": 19,
    "start": "00:01:37,978",
    "end": "00:01:41,489",
    "text": "Không tìm kiếm vinh quang danh vọng,"
  },
  {
    "id": 20,
    "start": "00:01:41,489",
    "end": "00:01:45,478",
    "text": "Chỉ mong Allah hài lòng mà thôi."
  },
  {
    "id": 21,
    "start": "00:01:45,478",
    "end": "00:01:49,228",
    "text": "Bao thử thách vẫn luôn kiên định,"
  },
  {
    "id": 22,
    "start": "00:01:49,228",
    "end": "00:01:52,899",
    "text": "Bao hiểm nguy chẳng khiến lùi bước."
  },
  {
    "id": 23,
    "start": "00:01:52,899",
    "end": "00:01:55,531",
    "text": "Vì sứ mệnh mang nguồn ánh sáng,"
  },
  {
    "id": 24,
    "start": "00:01:55,531",
    "end": "00:02:00,209",
    "text": "Đến muôn người trên khắp thế gian."
  },
  {
    "id": 25,
    "start": "00:02:00,558",
    "end": "00:02:04,149",
    "text": "Thời gian qua bao mùa năm tháng,"
  },
  {
    "id": 26,
    "start": "00:02:04,149",
    "end": "00:02:08,058",
    "text": "Ánh sáng ấy vẫn mãi còn đây."
  },
  {
    "id": 27,
    "start": "00:02:08,058",
    "end": "00:02:11,489",
    "text": "Soi trái tim tìm đường chân thật,"
  },
  {
    "id": 28,
    "start": "00:02:11,489",
    "end": "00:02:16,883",
    "text": "Dẫn nhân gian về với điều ngay."
  },
  {
    "id": 29,
    "start": "00:02:17,234",
    "end": "00:02:20,504",
    "text": "Hỡi anh em Muslim khắp nơi,"
  },
  {
    "id": 30,
    "start": "00:02:20,504",
    "end": "00:02:24,495",
    "text": "Hãy noi theo con đường Người đã mở."
  },
  {
    "id": 31,
    "start": "00:02:24,495",
    "end": "00:02:27,127",
    "text": "Muhammad, vị Nabi cuối cùng,"
  },
  {
    "id": 32,
    "start": "00:02:27,127",
    "end": "00:02:31,995",
    "text": "Niềm tự hào của toàn Ummah."
  },
  {
    "id": 33,
    "start": "00:02:31,995",
    "end": "00:02:35,745",
    "text": "Cầu xin bình an và phước lành,"
  },
  {
    "id": 34,
    "start": "00:02:35,745",
    "end": "00:02:39,574",
    "text": "Luôn được gửi đến Người mãi mãi."
  },
  {
    "id": 35,
    "start": "00:02:39,574",
    "end": "00:02:43,164",
    "text": "Mong ngày gặp lại nơi Đời Sau,"
  },
  {
    "id": 36,
    "start": "00:02:43,164",
    "end": "00:02:46,564",
    "text": "Dưới bóng hồng ân của Allah."
  },
  {
    "id": 37,
    "start": "00:02:46,914",
    "end": "00:02:49,627",
    "text": "Muhammad..."
  },
  {
    "id": 38,
    "start": "00:02:49,627",
    "end": "00:02:54,335",
    "text": "Vị Nabi cao quý..."
  },
  {
    "id": 39,
    "start": "00:02:54,335",
    "end": "00:02:55,293",
    "text": "Muhammad..."
  },
  {
    "id": 40,
    "start": "00:02:55,293",
    "end": "00:03:02,203",
    "text": "Người được Allah tuyển chọn..."
  }
]