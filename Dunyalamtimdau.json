    "text": "Ya Rahman..."
  },
  {
    "id": 6,
    "start": "00:00:27,286",
    "end": "00:00:27,919",
    "text": "Bầy tôi gọi Ngài."
  },
  {
    "id": 7,
    "start": "00:00:27,919",
    "end": "00:00:28,803",
    "text": "Ya Rahman..."
  },
  {
    "id": 8,
    "start": "00:00:37,021",
    "end": "00:00:38,137",
    "text": "Dunya làm tim đau,"
  },
  {
    "id": 9,
    "start": "00:00:38,137",
    "end": "00:00:39,654",
    "text": "Nhưng Allah chữa lành."
  },
  {
    "id": 10,
    "start": "00:00:39,654",
    "end": "00:00:41,409",
    "text": "Dẫu bao lần gục ngã,"
  },
  {
    "id": 11,
    "start": "00:00:41,409",
    "end": "00:00:42,926",
    "text": "Ngài vẫn ở bên."
  },
  {
    "id": 12,
    "start": "00:00:42,926",
    "end": "00:00:44,281",
    "text": "Ngài biết tim thổn thức,"
  },
  {
    "id": 13,
    "start": "00:00:44,281",
    "end": "00:00:45,878",
    "text": "Biết nỗi đau chẳng lời."
  },
  {
    "id": 14,
    "start": "00:00:45,878",
    "end": "00:00:47,472",
    "text": "Nên bầy tôi thì thầm:"
  },
  {
    "id": 15,
    "start": "00:00:47,472",
    "end": "00:01:06,911",
    "text": "Ya Rahman... một lần nữa."
  },
  {
    "id": 16,
    "start": "00:01:07,260",
    "end": "00:01:09,415",
    "text": "Ya Rahman..."
  },
  {
    "id": 17,
    "start": "00:01:09,415",
    "end": "00:01:12,655",
    "text": "Bầy tôi gọi Ngài."
  },
  {
    "id": 18,
    "start": "00:01:13,004",
    "end": "00:01:15,638",
    "text": "Ya Rahman..."
  },
  {
    "id": 19,
    "start": "00:01:15,638",
    "end": "00:01:17,995",
    "text": "Bầy tôi gọi Ngài."
  },
  {
    "id": 20,
    "start": "00:01:17,995",
    "end": "00:01:18,879",
    "text": "Ya Rahman..."
  },
  {
    "id": 21,
    "start": "00:01:31,436",
    "end": "00:01:32,871",
    "text": "Trần gian làm tim đau,"
  },
  {
    "id": 22,
    "start": "00:01:32,871",
    "end": "00:01:34,548",
    "text": "Nhưng Allah vẫn bên."
  },
  {
    "id": 23,
    "start": "00:01:34,548",
    "end": "00:01:35,983",
    "text": "Dẫu ngã bao lần,"
  },
  {
    "id": 24,
    "start": "00:01:35,983",
    "end": "00:01:37,420",
    "text": "Ngài không rời xa."
  },
  {
    "id": 25,
    "start": "00:01:44,281",
    "end": "00:01:45,558",
    "text": "Cười trên môi,"
  },
  {
    "id": 26,
    "start": "00:01:45,558",
    "end": "00:01:47,233",
    "text": "Che giấu tháng ngày dài."
  },
  {
    "id": 27,
    "start": "00:01:47,233",
    "end": "00:01:48,510",
    "text": "Áp lực đè vai,"
  },
  {
    "id": 28,
    "start": "00:01:48,510",
    "end": "00:01:50,186",
    "text": "Chẳng ai thấy bên trong."
  },
  {
    "id": 29,
    "start": "00:01:50,186",
    "end": "00:01:51,621",
    "text": "Họ nói: “Cứ tin”,"
  },
  {
    "id": 30,
    "start": "00:01:51,621",
    "end": "00:01:53,378",
    "text": "Đâu biết trận chiến âm thầm."
  },
  {
    "id": 31,
    "start": "00:01:53,378",
    "end": "00:01:54,733",
    "text": "Buồn tủi, nước mắt, đêm dài,"
  },
  {
    "id": 32,
    "start": "00:01:54,733",
    "end": "00:01:57,048",
    "text": "Xin Allah... mong bình an."
  },
  {
    "id": 33,
    "start": "00:01:57,048",
    "end": "00:01:58,245",
    "text": "Những đêm dài..."
  },
  {
    "id": 34,
    "start": "00:01:58,245",
    "end": "00:01:59,680",
    "text": "Được bình an..."
  },
  {
    "id": 35,
    "start": "00:01:59,680",
    "end": "00:02:00,878",
    "text": "Bầy tôi vẫn bước,"
  },
  {
    "id": 36,
    "start": "00:02:00,878",
    "end": "00:02:02,712",
    "text": "Tìm bình an... chẳng thấy."
  },
  {
    "id": 37,
    "start": "00:02:02,712",
    "end": "00:02:03,670",
    "text": "Nhưng trong nỗi đau,"
  },
  {
    "id": 38,
    "start": "00:02:03,670",
    "end": "00:02:09,254",
    "text": "Bầy tôi biết... nơi trở về."
  },
  {
    "id": 39,
    "start": "00:02:09,254",
    "end": "00:02:12,366",
    "text": "Nơi trở về..."
