[
  {
    "id": 1,
    "start": "00:00:21,222",
    "end": "00:00:26,329",
    "text": "Ngày gặp nhau chẳng phải tình cờ,"
  },
  {
    "id": 2,
    "start": "00:00:26,329",
    "end": "00:00:31,596",
    "text": "Mọi định đoạt đều từ Allah."
  },
  {
    "id": 3,
    "start": "00:00:31,596",
    "end": "00:00:36,621",
    "text": "Giữa bao người trên khắp thế gian,"
  },
  {
    "id": 4,
    "start": "00:00:36,621",
    "end": "00:00:41,537",
    "text": "Ngài đã chọn để cùng đồng hành."
  },
  {
    "id": 5,
    "start": "00:00:41,887",
    "end": "00:00:46,994",
    "text": "Có những ngày nắng vàng dịu nhẹ,"
  },
  {
    "id": 6,
    "start": "00:00:46,994",
    "end": "00:00:52,100",
    "text": "Có những đêm giông tố phủ đầy."
  },
  {
    "id": 7,
    "start": "00:00:52,100",
    "end": "00:00:55,612",
    "text": "Dẫu cuộc đời đổi thay từng lúc,"
  },
  {
    "id": 8,
    "start": "00:00:55,612",
    "end": "00:01:02,203",
    "text": "Vẫn bên nhau vì Allah mà thôi."
  },
  {
    "id": 9,
    "start": "00:01:02,552",
    "end": "00:01:04,069",
    "text": "Ya Allah..."
  },
  {
    "id": 10,
    "start": "00:01:04,069",
    "end": "00:01:09,334",
    "text": "Xin giữ trái tim luôn chân thành."
  },
  {
    "id": 11,
    "start": "00:01:09,334",
    "end": "00:01:14,043",
    "text": "Để mỗi bước đi trong cuộc sống,"
  },
  {
    "id": 12,
    "start": "00:01:14,043",
    "end": "00:01:20,584",
    "text": "Đều gần hơn với sự hài lòng của Ngài."
  },
  {
    "id": 13,
    "start": "00:01:20,584",
    "end": "00:01:22,100",
    "text": "Ya Allah..."
  },
  {
    "id": 14,
    "start": "00:01:22,100",
    "end": "00:01:25,611",
    "text": "Xin ban phước lành cho mái nhà."
  },
  {
    "id": 15,
    "start": "00:01:25,611",
    "end": "00:01:32,153",
    "text": "Để từng ngày trôi qua lặng lẽ,"
  },
  {
    "id": 16,
    "start": "00:01:32,153",
    "end": "00:01:40,900",
    "text": "Đều trở thành hành trình hướng về Ngài."
  },
  {
    "id": 17,
    "start": "00:01:41,250",
    "end": "00:01:46,277",
    "text": "Rồi tuổi trẻ cũng dần đi qua,"
  },
  {
    "id": 18,
    "start": "00:01:46,277",
    "end": "00:01:51,543",
    "text": "Mọi vẻ đẹp rồi sẽ phai nhòa."
  },
  {
    "id": 19,
    "start": "00:01:51,543",
    "end": "00:01:54,813",
    "text": "Chỉ những điều vì Allah lưu giữ,"
  },
  {
    "id": 20,
    "start": "00:01:54,813",
    "end": "00:02:01,564",
    "text": "Mới còn mãi đến tận ngày sau."
  },
  {
    "id": 21,
    "start": "00:02:01,915",
    "end": "00:02:07,021",
    "text": "Không vì của cải nơi thế gian,"
  },
  {
    "id": 22,
    "start": "00:02:07,021",
    "end": "00:02:12,206",
    "text": "Không vì những lời người ngợi khen."
  },
  {
    "id": 23,
    "start": "00:02:12,206",
    "end": "00:02:17,313",
    "text": "Chỉ mong sống một đời ngay thẳng,"
  },
  {
    "id": 24,
    "start": "00:02:17,313",
    "end": "00:02:22,150",
    "text": "Được Allah thương xót và chở che."
  },
  {
    "id": 25,
    "start": "00:02:22,500",
    "end": "00:02:23,697",
    "text": "Ya Allah..."
  },
  {
    "id": 26,
    "start": "00:02:23,697",
    "end": "00:02:27,206",
    "text": "Xin cho bầy tôi luôn biết ơn."
  },
  {
    "id": 27,
    "start": "00:02:27,206",
    "end": "00:02:33,909",
    "text": "Trong thuận lợi hay khi thử thách,"
  },
  {
    "id": 28,
    "start": "00:02:33,909",
    "end": "00:02:39,175",
    "text": "Vẫn kiên tâm trên con đường Ngài."
  },
  {
    "id": 29,
    "start": "00:02:39,175",
    "end": "00:02:40,293",
    "text": "Ya Allah..."
  },
  {
    "id": 30,
    "start": "00:02:40,293",
    "end": "00:02:45,399",
    "text": "Nếu Ngài hài lòng với bầy tôi."
  },
  {
    "id": 31,
    "start": "00:02:45,399",
    "end": "00:02:50,585",
    "text": "Xin cho gặp lại người bạn đời,"
  },
  {
    "id": 32,
    "start": "00:02:50,585",
    "end": "00:02:56,299",
    "text": "Trong Jannah của Ngài muôn đời."
  },
  {
    "id": 33,
    "start": "00:02:56,649",
    "end": "00:02:58,563",
    "text": "Allah... Allah..."
  },
  {
    "id": 34,
    "start": "00:03:01,914",
    "end": "00:03:01,914",
    "text": "Ya Rahman..."
  },
  {
    "id": 35,
    "start": "00:03:01,914",
    "end": "00:03:03,799",
    "text": "Ya Rahim..."
  },
  {
    "id": 36,
    "start": "00:03:16,276",
    "end": "00:03:21,462",
    "text": "Mọi cuộc gặp gỡ rồi sẽ qua,"
  },
  {
    "id": 37,
    "start": "00:03:21,462",
    "end": "00:03:25,212",
    "text": "Mọi điều đẹp đẽ rồi sẽ xa."
  },
  {
    "id": 38,
    "start": "00:03:25,212",
    "end": "00:03:32,234",
    "text": "Chỉ những gì làm vì Allah,"
  },
  {
    "id": 39,
    "start": "00:03:32,234",
    "end": "00:03:35,155",
    "text": "Sẽ còn mãi chẳng bao giờ mất."
  }
]