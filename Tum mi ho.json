[
  {
    "id": 1,
    "start": "00:00:22,100",
    "end": "00:00:27,207",
    "text": "Bề tôi biết sống sao, nếu không có Ngài?"
  },
  {
    "id": 2,
    "start": "00:00:27,207",
    "end": "00:00:31,277",
    "text": "Nếu xa Ngài, đời chẵng còn ý nghĩa gì."
  },
  {
    "id": 3,
    "start": "00:00:37,261",
    "end": "00:00:42,447",
    "text": "Bề tôi biết sống sao, nếu không có Ngài?"
  },
  {
    "id": 4,
    "start": "00:00:42,447",
    "end": "00:00:47,472",
    "text": "Nếu xa Ngài, đời chẵng còn ý nghĩa gì."
  },
  {
    "id": 5,
    "start": "00:00:47,472",
    "end": "00:00:52,100",
    "text": "Nếu một ngày, bề tôi phải rời xa Ngài,"
  },
  {
    "id": 6,
    "start": "00:00:52,100",
    "end": "00:00:57,606",
    "text": "Thì chính bề tôi, cũng lạc mất chính mình."
  },
  {
    "id": 7,
    "start": "00:01:00,718",
    "end": "00:01:05,745",
    "text": "Không có Ngài, chẳng còn gì nữa,"
  },
  {
    "id": 8,
    "start": "00:01:05,745",
    "end": "00:01:10,850",
    "text": "Không có Ngài, lòng chẳng thể bình yên."
  },
  {
    "id": 9,
    "start": "00:01:10,850",
    "end": "00:01:15,878",
    "text": "Ya Rabbi, Ngài là nơi trở về..."
  },
  {
    "id": 10,
    "start": "00:01:15,878",
    "end": "00:01:18,350",
    "text": "Chỉ có Ngài… chỉ mình Ngài ..."
  },
  {
    "id": 11,
    "start": "00:01:18,350",
    "end": "00:01:25,371",
    "text": "Duy chỉ Ngài… Ôi Allah…"
  },
  {
    "id": 12,
    "start": "00:01:25,371",
    "end": "00:01:30,399",
    "text": "Ya...rabbi.."
  },
  {
    "id": 13,
    "start": "00:01:30,399",
    "end": "00:01:41,090",
    "text": "Ya...rabbi.."
  },
  {
    "id": 14,
    "start": "00:01:41,090",
    "end": "00:01:45,239",
    "text": "Mối duyên này, chỉ giữa Ngài và bề tôi,"
  },
  {
    "id": 15,
    "start": "00:01:45,239",
    "end": "00:01:51,222",
    "text": "Bề tôi không muốn xa Ngài, dù một giây phút."
  },
  {
    "id": 16,
    "start": "00:01:51,222",
    "end": "00:01:56,250",
    "text": "Bao tháng năm, lòng thành tâm xin dâng lên Ngài,"
  },
  {
    "id": 17,
    "start": "00:01:56,250",
    "end": "00:01:56,269",
    "text": "Từng ngày qua, đều thuộc về Ngài."
  },
  {
    "id": 18,
    "start": "00:01:57,207",
    "end": "00:01:58,165",
    "text": "Ya Rabbi…"
  },
  {
    "id": 19,
    "start": "00:01:59,121",
    "end": "00:02:00,079",
    "text": "Ya Rabbi…"
  },
  {
    "id": 20,
    "start": "00:02:01,915",
    "end": "00:02:06,302",
    "text": "Chẳng phút giây nào, trong tâm trí bềtôi,"
  },
  {
    "id": 21,
    "start": "00:02:06,302",
    "end": "00:02:11,409",
    "text": "Sống một đời, lại chấp nhận thiếu vắng Ngài."
  },
  {
    "id": 22,
    "start": "00:02:11,409",
    "end": "00:02:16,436",
    "text": "Mỗi hơi thở, bề tôi gọi tên Ngài,"
  },
  {
    "id": 23,
    "start": "00:02:16,436",
    "end": "00:02:21,622",
    "text": "Mỗi bước chân, hướng về nơi Ngài."
  },
  {
    "id": 24,
    "start": "00:02:21,622",
    "end": "00:02:24,096",
    "text": "Chỉ có Ngài......"
  },
  {
    "id": 25,
    "start": "00:02:24,096",
    "end": "00:02:26,489",
    "text": "ôi Allah!"
  },
  {
    "id": 26,
    "start": "00:02:26,489",
    "end": "00:02:28,085",
    "text": "Niềm vui này,"
  },
  {
    "id": 27,
    "start": "00:02:28,085",
    "end": "00:02:31,675",
    "text": "Từ Ngài ban xuống."
  },
  {
    "id": 28,
    "start": "00:02:31,675",
    "end": "00:02:34,229",
    "text": "Chỉ có Ngài......"
  },
  {
    "id": 29,
    "start": "00:02:34,229",
    "end": "00:02:36,622",
    "text": "ôi Allah!"
  },
  {
    "id": 30,
    "start": "00:02:36,622",
    "end": "00:02:38,855",
    "text": "Mọi bình yên,"
  },
  {
    "id": 31,
    "start": "00:02:38,855",
    "end": "00:02:41,808",
    "text": "đều đến từ Ngài."
  },
  {
    "id": 32,
    "start": "00:02:41,808",
    "end": "00:02:46,835",
    "text": "ôi Allah, chỉ có Ngài.."
  },
  {
    "id": 33,
    "start": "00:02:46,835",
    "end": "00:02:51,782",
    "text": "Là ánh sáng soi lối bề tôi."
  },
  {
    "id": 34,
    "start": "00:02:51,782",
    "end": "00:02:56,489",
    "text": "Mỗi hơi thở, đều tạ ơn Ngài,"
  },
  {
    "id": 35,
    "start": "00:02:56,489",
    "end": "00:03:01,436",
    "text": "Cuộc đời bề tôi… chỉ thuộc về Ngài."
  },
  {
    "id": 36,
    "start": "00:03:01,436",
    "end": "00:03:02,872",
    "text": "Ya Rabbi…"
  },
  {
    "id": 37,
    "start": "00:03:02,872",
    "end": "00:03:07,979",
    "text": "Xin giữ bề tôi trên con đường ngay thẳng,"
  },
  {
    "id": 38,
    "start": "00:03:07,979",
    "end": "00:03:12,127",
    "text": "Đừng để bề tôi lạc khỏi ánh sáng Ngài,"
  },
  {
    "id": 39,
    "start": "00:03:12,127",
    "end": "00:03:17,153",
    "text": "Không có Ngài, bề tôi chắc chắn lạc lối..."
  },
  {
    "id": 40,
    "start": "00:03:17,153",
    "end": "00:03:23,217",
    "text": "Chỉ có Ngài… là nơi bề tôi trở về."
  },
  {
    "id": 41,
    "start": "00:03:23,217",
    "end": "00:03:27,206",
    "text": "Ya...rabbi.."
  },
